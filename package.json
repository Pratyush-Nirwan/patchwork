{
  "name": "patchwork",
  "version": "0.8.0-beta",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pratyush-Nirwan/patchwork.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/run-chain.mjs docs:build build:app",
    "build:app": "next build",
    "start": "node scripts/supervisor.mjs",
    "worker": "node scripts/worker.mjs",
    "stop": "node scripts/stop.mjs",
    "status": "node scripts/status.mjs",
    "setup": "node scripts/setup.mjs",
    "seed": "node scripts/seed.mjs",
    "lint": "node scripts/run-chain.mjs lint:eslint loading:check",
    "lint:eslint": "eslint src scripts tests e2e",
    "loading:check": "node scripts/check-loading-states.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset:test": "node scripts/run-chain.mjs node:scripts/dev-minio.mjs node:scripts/reset-test-db.mjs",
    "services:test": "node scripts/dev-minio.mjs",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:e2e": "playwright test",
    "docs:dev": "npm --prefix website run dev",
    "docs:export": "node scripts/docs/export-data.mjs",
    "docs:build:site": "npm --prefix website run build:website",
    "docs:build": "node scripts/docs/build-embedded.mjs",
    "docs:build:standalone": "npm --prefix website run build:website",
    "docs:preview": "npm --prefix website run preview",
    "docs:generate:website": "npm --prefix website run generate",
    "docs:generate": "node scripts/run-chain.mjs docs:export docs:generate:website",
    "docs:screenshots": "node scripts/docs/screenshots.mjs",
    "website:screenshots": "node scripts/docs/screenshots.mjs",
    "docs:check": "node scripts/docs/check.mjs",
    "changelog:check": "node website/scripts/changelog.mjs --check",
    "isolation:check": "node scripts/check-website-isolation.mjs",
    "readme:screenshots": "node scripts/docs/readme-screenshots.mjs",
    "readme:generate": "node scripts/docs/readme.mjs",
    "readme:check": "node scripts/docs/readme-check.mjs",
    "version:check": "node scripts/check-version.mjs",
    "release:docs": "node scripts/docs/release.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "verify": "node scripts/run-chain.mjs services:test db:reset:test version:check isolation:check changelog:check readme:check docs:check docs:build lint typecheck test build test:e2e node:scripts/smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@clack/prompts": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "argon2": "^0.41.1",
    "cmdk": "^1.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "embedded-postgres": "^18.6.0-beta.19",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "nodemailer": "^10.6.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.2.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7",
    "markdownlint-cli2": "^0.24.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

---
import { Image } from "astro:assets";
import boardLight from "../../assets/screenshots/board-light.png";
import boardDark from "../../assets/screenshots/board-dark.png";
---

<div class="pw-preview-shell" data-pw-preview>
  <div class="pw-preview-bar">
    <div class="pw-preview-bar-left">
      <span class="pw-preview-badge">Interactive workspace &middot; Sample data</span>
      <span class="pw-preview-hint">Drag cards across columns, use arrow keys, or press <code>Ctrl+K</code></span>
    </div>
    <div class="pw-preview-actions">
      <button type="button" class="pw-cmd-trigger" id="pw-preview-cmd-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <span>Search or run <code>/</code> command...</span>
        <kbd>Ctrl+K</kbd>
      </button>
    </div>
  </div>

  <div class="pw-preview-board" id="pw-preview-board" hidden>
    <section class="pw-preview-col" data-col="New" data-wip="4">
      <div class="pw-col-header">
        <div class="pw-col-top">
          <div class="pw-col-title-wrap">
            <span class="pw-col-dot" style="background:#64748b"></span>
            <h3>New</h3>
          </div>
          <span class="pw-wip-badge pw-tabular" data-col-count>1/4</span>
        </div>
        <div class="pw-wip-track"><div class="pw-wip-fill" data-wip-fill style="width:25%"></div></div>
      </div>
      <div class="pw-col-list" data-col-list>
        <article class="pw-card" draggable="true" tabindex="0" data-card-id="API-14" data-title="Add SSE reconnect backoff" data-watching="false">
          <div class="pw-card-top">
            <span class="pw-card-key pw-tabular">API-14</span>
            <span class="pw-prio pw-prio-high">HIGH</span>
          </div>
          <h4 class="pw-card-title">Add SSE reconnect backoff</h4>
          <div class="pw-card-labels">
            <span>sse</span>
            <span>realtime</span>
          </div>
          <div class="pw-card-foot">
            <span class="pw-card-assignee">Alex Chen</span>
            <div class="pw-card-metrics pw-tabular">
              <span title="Comments">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                3
              </span>
              <span title="Attachments">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                1
              </span>
              <span class="pw-watch-eye" data-watch-eye hidden title="Watching" aria-label="Watching">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              </span>
            </div>
          </div>
        </article>
      </div>
      <div class="pw-col-footer">
        <button type="button" class="pw-add-ticket-btn" data-quick-new>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          <span>Add Ticket</span>
        </button>
      </div>
    </section>

    <section class="pw-preview-col" data-col="In Progress" data-wip="3">
      <div class="pw-col-header">
        <div class="pw-col-top">
          <div class="pw-col-title-wrap">
            <span class="pw-col-dot" style="background:#2563eb"></span>
            <h3>In Progress</h3>
          </div>
          <span class="pw-wip-badge pw-tabular" data-col-count>1/3</span>
        </div>
        <div class="pw-wip-track"><div class="pw-wip-fill" data-wip-fill style="width:33%"></div></div>
      </div>
      <div class="pw-col-list" data-col-list>
        <article class="pw-card" draggable="true" tabindex="0" data-card-id="CORE-8" data-title="Index PDF attachments in FTS" data-watching="true">
          <div class="pw-card-top">
            <span class="pw-card-key pw-tabular">CORE-8</span>
            <span class="pw-prio pw-prio-urgent">URGENT</span>
          </div>
          <h4 class="pw-card-title">Index PDF attachments in FTS</h4>
          <div class="pw-card-labels">
            <span>postgres</span>
            <span>fts</span>
          </div>
          <div class="pw-card-foot">
            <span class="pw-card-assignee">Maya Haddad</span>
            <div class="pw-card-metrics pw-tabular">
              <span title="Comments">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                5
              </span>
              <span title="Attachments">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                2
              </span>
              <span class="pw-watch-eye" data-watch-eye title="Watching" aria-label="Watching">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              </span>
            </div>
          </div>
        </article>
      </div>
      <div class="pw-col-footer">
        <button type="button" class="pw-add-ticket-btn" data-quick-new>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          <span>Add Ticket</span>
        </button>
      </div>
    </section>

    <section class="pw-preview-col" data-col="In Review" data-wip="2">
      <div class="pw-col-header">
        <div class="pw-col-top">
          <div class="pw-col-title-wrap">
            <span class="pw-col-dot" style="background:#d97706"></span>
            <h3>In Review</h3>
          </div>
          <span class="pw-wip-badge pw-tabular" data-col-count>1/2</span>
        </div>
        <div class="pw-wip-track"><div class="pw-wip-fill" data-wip-fill style="width:50%"></div></div>
      </div>
      <div class="pw-col-list" data-col-list>
        <article class="pw-card" draggable="true" tabindex="0" data-card-id="WEB-21" data-title="Link GitHub PR #42 preview" data-watching="false">
          <div class="pw-card-top">
            <span class="pw-card-key pw-tabular">WEB-21</span>
            <span class="pw-prio pw-prio-medium">MEDIUM</span>
          </div>
          <h4 class="pw-card-title">Link GitHub PR #42 preview</h4>
          <div class="pw-card-labels">
            <span>github</span>
          </div>
          <div class="pw-card-foot">
            <span class="pw-card-assignee">Devon Kim</span>
            <div class="pw-card-metrics pw-tabular">
              <span title="Comments">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                2
              </span>
              <span title="Git Links">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><line x1="6" y1="9" x2="6" y2="21"/></svg>
                1
              </span>
              <span class="pw-watch-eye" data-watch-eye hidden title="Watching" aria-label="Watching">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              </span>
            </div>
          </div>
        </article>
      </div>
      <div class="pw-col-footer">
        <button type="button" class="pw-add-ticket-btn" data-quick-new>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          <span>Add Ticket</span>
        </button>
      </div>
    </section>

    <section class="pw-preview-col" data-col="Done" data-wip="6">
      <div class="pw-col-header">
        <div class="pw-col-top">
          <div class="pw-col-title-wrap">
            <span class="pw-col-dot" style="background:#16a34a"></span>
            <h3>Done</h3>
          </div>
          <span class="pw-wip-badge pw-tabular" data-col-count>0/6</span>
        </div>
        <div class="pw-wip-track"><div class="pw-wip-fill" data-wip-fill style="width:0%"></div></div>
      </div>
      <div class="pw-col-list" data-col-list>
        <div class="pw-empty-drop" data-empty-drop>Drop tickets here</div>
      </div>
      <div class="pw-col-footer">
        <button type="button" class="pw-add-ticket-btn" data-quick-new>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          <span>Add Ticket</span>
        </button>
      </div>
    </section>
  </div>

  <div class="pw-preview-fallback" id="pw-preview-fallback">
    <Image src={boardLight} alt="Patchwork Kanban board static preview (light)" class="pw-img-light" loading="lazy" />
    <Image src={boardDark} alt="Patchwork Kanban board static preview (dark)" class="pw-img-dark" loading="lazy" />
  </div>

  <div class="pw-snackbar" id="pw-preview-snackbar" role="status" aria-live="polite" hidden></div>

  <dialog class="pw-spotlight-dialog" id="pw-preview-dialog" aria-label="Patchwork Command Bar">
    <div class="pw-spotlight-panel">
      <div class="pw-spotlight-input-row" id="pw-spotlight-search-row">
        <svg class="pw-spotlight-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <input type="text" id="pw-preview-input" autocomplete="off" spellcheck="false" placeholder="Search tickets, boards, or type / for commands..." aria-label="Command bar input" />
        <button type="button" class="pw-spotlight-clear" id="pw-spotlight-clear-btn" aria-label="Clear command input" hidden>&times;</button>
      </div>

      <div class="pw-spotlight-input-row" id="pw-spotlight-pill-row" hidden>
        <svg class="pw-spotlight-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <div class="pw-pill-group" role="group" aria-label="Command">
          <span class="pw-pill-cmd" id="pw-pill-cmd">/move</span>
          <div id="pw-pill-slots" class="pw-pill-slots"></div>
          <span class="pw-run-badge" id="pw-pill-run" hidden>&#8629; Run</span>
        </div>
        <button type="button" class="pw-spotlight-clear" id="pw-pill-clear-btn" aria-label="Clear command input">&times;</button>
      </div>

      <div class="pw-spotlight-list" id="pw-spotlight-list" role="listbox" aria-label="Commands and results">
        <div class="pw-spotlight-group-label">Slash Commands</div>
        <button type="button" class="pw-spotlight-item" data-cmd-pick="new"><span class="pw-item-left"><code>/new</code> <span>Create a new ticket</span></span><span class="pw-item-hint">title: ticket title</span></button>
        <button type="button" class="pw-spotlight-item" data-cmd-pick="move"><span class="pw-item-left"><code>/move</code> <span>Move a ticket to another column</span></span><span class="pw-item-hint">ticket: key column: column</span></button>
        <button type="button" class="pw-spotlight-item" data-cmd-pick="watch"><span class="pw-item-left"><code>/watch</code> <span>Subscribe to ticket updates</span></span><span class="pw-item-hint">ticket: key</span></button>
        <button type="button" class="pw-spotlight-item" data-cmd-pick="unwatch"><span class="pw-item-left"><code>/unwatch</code> <span>Stop watching a ticket</span></span><span class="pw-item-hint">ticket: key</span></button>
        <button type="button" class="pw-spotlight-item" data-cmd-pick="theme"><span class="pw-item-left"><code>/theme</code> <span>Switch light or dark theme</span></span><span class="pw-item-hint">mode: light | dark</span></button>
      </div>

      <div class="pw-spotlight-footer">
        <span class="pw-cmd-status" id="pw-preview-cmd-status" role="status">Type <code>/new </code>, <code>/move </code>, or <code>/watch </code> to enter labeled pill mode</span>
        <div class="pw-spotlight-keys">
          <span><kbd>Tab</kbd> Next pill</span>
          <span><kbd>&#8629;</kbd> Run</span>
          <button type="button" class="pw-esc-btn" id="pw-preview-close"><kbd>Esc</kbd></button>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  const board = document.getElementById("pw-preview-board");
  const fallback = document.getElementById("pw-preview-fallback");
  const snackbar = document.getElementById("pw-preview-snackbar");
  if (board && fallback) { board.hidden = false; fallback.hidden = true; }
  let snackTimer: ReturnType<typeof setTimeout> | undefined;
  const showSnack = (msg: string) => {
    if (!snackbar) return;
    snackbar.textContent = msg;
    snackbar.hidden = false;
    clearTimeout(snackTimer);
    snackTimer = setTimeout(() => { snackbar.hidden = true; }, 2600);
  };
  const cols = Array.from(document.querySelectorAll(".pw-preview-col"));
  const updateCounts = () => {
    for (const c of cols) {
      const count = c.querySelectorAll(".pw-card").length;
      const wip = Number(c.getAttribute("data-wip") || "0");
      const badge = c.querySelector("[data-col-count]");
      const fill = c.querySelector("[data-wip-fill]") as HTMLElement | null;
      const empty = c.querySelector("[data-empty-drop]") as HTMLElement | null;
      if (badge) { badge.textContent = wip ? `${count}/${wip}` : String(count); badge.classList.toggle("is-over", wip > 0 && count > wip); }
      if (fill && wip > 0) { fill.style.width = `${Math.min(100, Math.round((count / wip) * 100))}%`; fill.classList.toggle("is-over", count > wip); }
      if (empty) empty.hidden = count > 0;
    }
  };
  let draggedId = "";
  board?.addEventListener("dragstart", (e) => { const card = e.target instanceof Element ? e.target.closest(".pw-card") : null; if (card) { draggedId = card.getAttribute("data-card-id") || ""; card.classList.add("is-dragging"); } });
  board?.addEventListener("dragend", (e) => { const card = e.target instanceof Element ? e.target.closest(".pw-card") : null; card?.classList.remove("is-dragging"); });
  board?.addEventListener("dragover", (e) => e.preventDefault());
  board?.addEventListener("drop", (e) => {
    e.preventDefault();
    const col = e.target instanceof Element ? e.target.closest(".pw-preview-col") : null;
    const card = board.querySelector(`.pw-card[data-card-id="${draggedId}"]`);
    if (col && card) { col.querySelector("[data-col-list]")?.appendChild(card); updateCounts(); showSnack(`Moved ${draggedId} to ${col.getAttribute("data-col")}`); }
  });
  board?.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
    const card = e.target instanceof Element ? e.target.closest(".pw-card") : null;
    const col = card?.closest(".pw-preview-col");
    if (!card || !col) return;
    e.preventDefault();
    const idx = cols.indexOf(col);
    const nextIdx = e.key === "ArrowRight" ? idx + 1 : idx - 1;
    if (nextIdx >= 0 && nextIdx < cols.length) {
      cols[nextIdx].querySelector("[data-col-list]")?.appendChild(card);
      updateCounts();
      if (card instanceof HTMLElement) card.focus();
      showSnack(`Moved ${card.getAttribute("data-card-id")} to ${cols[nextIdx].getAttribute("data-col")}`);
    }
  });
  const dlg = document.getElementById("pw-preview-dialog") as HTMLDialogElement | null;
  const cmdBtn = document.getElementById("pw-preview-cmd-btn");
  const closeBtn = document.getElementById("pw-preview-close");
  const searchRow = document.getElementById("pw-spotlight-search-row");
  const pillRow = document.getElementById("pw-spotlight-pill-row");
  const input = document.getElementById("pw-preview-input") as HTMLInputElement | null;
  const clearBtn = document.getElementById("pw-spotlight-clear-btn");
  const pillClearBtn = document.getElementById("pw-pill-clear-btn");
  const pillCmdEl = document.getElementById("pw-pill-cmd");
  const pillSlotsEl = document.getElementById("pw-pill-slots");
  const pillRunEl = document.getElementById("pw-pill-run");
  const status = document.getElementById("pw-preview-cmd-status");
  interface PillSpec { key: string; label: string; placeholder: string; value: string; }
  const COMMAND_SPECS: Record<string, PillSpec[]> = {
    new: [{ key: "title", label: "title", placeholder: "ticket title", value: "" }, { key: "priority", label: "priority", placeholder: "medium", value: "" }],
    move: [{ key: "key", label: "ticket", placeholder: "API-14", value: "" }, { key: "column", label: "column", placeholder: "Done", value: "" }],
    watch: [{ key: "key", label: "ticket", placeholder: "API-14", value: "" }],
    unwatch: [{ key: "key", label: "ticket", placeholder: "CORE-8", value: "" }],
    theme: [{ key: "mode", label: "mode", placeholder: "dark | light", value: "" }],
  };
  let activeCmd: string | null = null;
  let activePills: PillSpec[] = [];
  const exitPillMode = () => {
    activeCmd = null; activePills = [];
    if (searchRow) searchRow.hidden = false;
    if (pillRow) pillRow.hidden = true;
    if (input) { input.value = ""; input.focus(); }
    if (clearBtn) clearBtn.hidden = true;
  };
  const renderPills = (focusIdx = 0) => {
    if (!pillSlotsEl || !pillCmdEl || !pillRunEl) return;
    pillCmdEl.textContent = `/${activeCmd}`;
    pillSlotsEl.innerHTML = "";
    activePills.forEach((p, idx) => {
      const chip = document.createElement("div"); chip.className = "pw-pill-chip";
      const lbl = document.createElement("span"); lbl.className = "pw-pill-label"; lbl.textContent = `${p.label}:`;
      const inp = document.createElement("input"); inp.type = "text"; inp.className = "pw-pill-input";
      inp.placeholder = p.placeholder; inp.value = p.value; inp.size = Math.max((p.value || p.placeholder).length + 1, 6);
      inp.addEventListener("input", () => { p.value = inp.value; inp.size = Math.max((p.value || p.placeholder).length + 1, 6); pillRunEl.hidden = !Boolean(activePills[0]?.value.trim()); });
      inp.addEventListener("keydown", (e) => {
        if (e.key === "Backspace" && inp.value === "" && idx === 0) { e.preventDefault(); exitPillMode(); }
        else if (e.key === "Enter") { e.preventDefault(); executeActiveCommand(); }
      });
      chip.appendChild(lbl); chip.appendChild(inp); pillSlotsEl.appendChild(chip);
      if (idx === focusIdx) requestAnimationFrame(() => inp.focus());
    });
    pillRunEl.hidden = !Boolean(activePills[0]?.value.trim());
  };
  const enterPillMode = (cmdName: string, initialFirst = "") => {
    const template = COMMAND_SPECS[cmdName]; if (!template) return;
    activeCmd = cmdName; activePills = template.map((p, i) => ({ ...p, value: i === 0 ? initialFirst : "" }));
    if (searchRow) searchRow.hidden = true; if (pillRow) pillRow.hidden = false;
    renderPills(0);
  };
  const executeActiveCommand = () => {
    if (!activeCmd) return;
    const v0 = (activePills[0]?.value || activePills[0]?.placeholder || "").trim();
    const v1 = (activePills[1]?.value || "").trim();
    if (activeCmd === "new") {
      const title = v0 || "New sample ticket";
      const prio = ["low", "medium", "high", "urgent"].includes(v1.toLowerCase()) ? v1.toLowerCase() : "medium";
      const id = `PW-${Math.floor(30 + Math.random() * 60)}`;
      const card = document.createElement("article"); card.className = "pw-card"; card.draggable = true; card.tabIndex = 0; card.setAttribute("data-card-id", id);
      card.innerHTML = `<div class="pw-card-top"><span class="pw-card-key pw-tabular">${id}</span><span class="pw-prio pw-prio-${prio}">${prio.toUpperCase()}</span></div><h4 class="pw-card-title"></h4><div class="pw-card-foot"><span class="pw-card-assignee">You</span><div class="pw-card-metrics pw-tabular"><span class="pw-watch-eye" data-watch-eye title="Watching"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></span></div></div>`;
      const tEl = card.querySelector(".pw-card-title"); if (tEl) tEl.textContent = title;
      cols[0]?.querySelector("[data-col-list]")?.prepend(card); updateCounts(); showSnack(`Created ${id}: ${title}`); dlg?.close();
    } else if (activeCmd === "move") {
      const key = v0.toUpperCase(); const target = (v1 || "Done").toLowerCase();
      const card = board?.querySelector(`.pw-card[data-card-id="${key}"]`);
      const col = cols.find((c) => (c.getAttribute("data-col") || "").toLowerCase().includes(target));
      if (card && col) { col.querySelector("[data-col-list]")?.appendChild(card); updateCounts(); showSnack(`Moved ${key} to ${col.getAttribute("data-col")}`); dlg?.close(); }
      else if (status) status.textContent = `Ticket "${key}" or column "${v1 || "Done"}" not found.`;
    } else if (activeCmd === "watch" || activeCmd === "unwatch") {
      const key = v0.toUpperCase(); const card = board?.querySelector(`.pw-card[data-card-id="${key}"]`);
      const eye = card?.querySelector("[data-watch-eye]") as HTMLElement | null;
      if (card && eye) { const watching = activeCmd === "watch"; eye.hidden = !watching; showSnack(`${watching ? "Watching" : "Unwatched"} ${key}`); dlg?.close(); }
      else if (status) status.textContent = `Ticket "${key}" not found.`;
    } else if (activeCmd === "theme") {
      const mode = v0.toLowerCase() === "light" ? "light" : "dark";
      document.documentElement.dataset.theme = mode;
      try { localStorage.setItem("patchwork_theme", mode); localStorage.setItem("starlight-theme", mode); } catch {}
      showSnack(`Switched to ${mode} theme`); dlg?.close();
    }
  };

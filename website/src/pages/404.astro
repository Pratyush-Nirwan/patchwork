---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import appMeta from "../data/generated/app-meta.json";

const rawBase = process.env.SITE_BASE || "/";
const basePrefix = rawBase === "/" ? "" : `/${rawBase.replace(/^\/+|\/+$/g, "")}`;
const href = (p: string) => `${basePrefix}${p}`;
---

<MarketingLayout
  title="Page not found — Patchwork"
  description="The requested page could not be found."
  canonicalPath="/404.html"
>
  <div class="pw-container pw-page-body">
    <p class="pw-code pw-tabular">404</p>
    <h1>Page not found</h1>
    <p>The page you requested does not exist in Patchwork {appMeta.displayVersion}.</p>
    <div class="pw-links">
      <a href={href("/")}>Home</a>
      <a href={href("/documentation/")}>Documentation</a>
      <a href={href("/features/")}>Features</a>
      <a href={href("/get-started/")}>Get started</a>
    </div>
  </div>
</MarketingLayout>

<style>
  .pw-page-body {
    padding: 4rem 1.25rem;
    max-width: 720px;
  }
  .pw-code {
    font-family: var(--pw-font-mono);
    font-size: 1rem;
    color: var(--pw-accent);
    margin: 0 0 0.5rem;
  }
  .pw-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }
</style>

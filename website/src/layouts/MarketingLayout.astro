---
import "../styles/tokens.css";
import appMeta from "../data/generated/app-meta.json";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = "/",
  ogImage = "/og-image.png",
  ogImageAlt = "Patchwork — Ticketing for engineering orgs that run their own stack.",
  noindex = false,
} = Astro.props;
const rawBase = process.env.SITE_BASE || "/";
const basePrefix = rawBase === "/" ? "" : `/${rawBase.replace(/^\/+|\/+$/g, "")}`;
const defaultSiteOrigin = new URL(appMeta.docsSiteUrl || "https://getpatchwork.in/").origin;
const rawSiteUrl =
  process.env.SITE_URL ||
  (process.env.VERCEL_PROJECT_PRODUCTION_URL
    ? `https://${process.env.VERCEL_PROJECT_PRODUCTION_URL}`
    : process.env.VERCEL_URL
      ? `https://${process.env.VERCEL_URL}`
      : defaultSiteOrigin);
const siteOrigin = rawSiteUrl.replace(/\/+$/, "");
const repoUrl = process.env.REPO_URL || appMeta.repositoryUrl;
const canonicalUrl = `${siteOrigin}${basePrefix}${canonicalPath}`;
const ogImageUrl = `${siteOrigin}${basePrefix}${ogImage}`;

const href = (p: string) => `${basePrefix}${p}`;

const jsonLd = !noindex
  ? [
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: appMeta.name,
        description,
        softwareVersion: appMeta.displayVersion,
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Windows 10, Windows 11, Linux",
        license: `${repoUrl}/blob/main/LICENSE`,
        url: `${siteOrigin}${basePrefix}/`,
        image: ogImageUrl,
        isAccessibleForFree: true,
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "USD",
        },
      },
      ...(canonicalPath === "/"
        ? [
            {
              "@context": "https://schema.org",
              "@type": "Organization",
              name: appMeta.name,
              url: `${siteOrigin}${basePrefix}/`,
              sameAs: [repoUrl],
            },
          ]
        : [
            {
              "@context": "https://schema.org",
              "@type": "BreadcrumbList",
              itemListElement: [
                { "@type": "ListItem", position: 1, name: "Home", item: `${siteOrigin}${basePrefix}/` },
                { "@type": "ListItem", position: 2, name: title.replace(/\s*—\s*Patchwork.*$/, ""), item: canonicalUrl },
              ],
            },
          ]),
    ]
  : null;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="manifest" href={href("/site.webmanifest")} />
    <meta property="og:site_name" content="Patchwork" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      try {
        var t = localStorage.getItem("patchwork_theme") || localStorage.getItem("starlight-theme");
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = t;
        localStorage.setItem("patchwork_theme", t);
        localStorage.setItem("starlight-theme", t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="pw-skip-link" href="#main">Skip to main content</a>
    <header class="pw-site-header">
      <div class="pw-container pw-header-inner">
        <a class="pw-brand" href={href("/")}>
          <svg width="28" height="28" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <rect x="4" y="4" width="40" height="40" rx="10" fill="#141920" />
            <g transform="rotate(-12 24 24)">
              <path d="M10 16C10 14.9 10.9 14 12 14H36C37.1 14 38 14.9 38 16V20.5C36.2 20.5 34.8 22.1 34.8 24C34.8 25.9 36.2 27.5 38 27.5V32C38 33.1 37.1 34 36 34H12C10.9 34 10 33.1 10 32V27.5C11.8 27.5 13.2 25.9 13.2 24C13.2 22.1 11.8 20.5 10 20.5V16Z" fill="#EAEEF3" />
              <path d="M10 16C10 14.9 10.9 14 12 14H19V34H12C10.9 34 10 33.1 10 32V27.5C11.8 27.5 13.2 25.9 13.2 24C13.2 22.1 11.8 20.5 10 20.5V16Z" fill="#F05A28" />
              <line x1="19" y1="16" x2="19" y2="32" stroke="#141920" stroke-width="1.8" stroke-dasharray="2.2 2.2" />
              <line x1="23.5" y1="21" x2="31.5" y2="21" stroke="#141920" stroke-width="2.2" stroke-linecap="round" />
              <line x1="23.5" y1="27" x2="29.5" y2="27" stroke="#141920" stroke-width="2.2" stroke-linecap="round" />
            </g>
          </svg>
          <span>Patchwork</span>
        </a>
        <div class="pw-header-actions">
          <button type="button" class="pw-theme-btn" id="pw-theme-toggle" aria-label="Switch to dark theme" title="Switch to dark theme">
            <svg class="pw-theme-icon pw-theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <svg class="pw-theme-icon pw-theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
          </button>
          <button
            type="button"
            class="pw-menu-btn"
            id="pw-menu-toggle"
            aria-expanded="false"
            aria-controls="pw-primary-nav"
            aria-label="Toggle navigation menu"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <line x1="3" y1="6" x2="17" y2="6" class="pw-burger-top" />
              <line x1="3" y1="10" x2="17" y2="10" class="pw-burger-mid" />
              <line x1="3" y1="14" x2="17" y2="14" class="pw-burger-bot" />
            </svg>
          </button>
        </div>
        <nav class="pw-nav" id="pw-primary-nav" aria-label="Main navigation">
          <a href={href("/features/")}>Features</a>
          <a href={href("/get-started/")}>Get started</a>
          <a href={href("/documentation/")}>Documentation</a>
          <a href={repoUrl} class="pw-nav-gh" aria-label="Star Patchwork on GitHub">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z" />
            </svg>
            <span>Star</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="pw-site-footer">
      <div class="pw-container">
        <div class="pw-footer-grid">
          <div class="pw-footer-brand-col">
            <a class="pw-brand" href={href("/")}>
              <svg width="24" height="24" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                <rect x="4" y="4" width="40" height="40" rx="10" fill="#141920" />
                <g transform="rotate(-12 24 24)">
                  <path d="M10 16C10 14.9 10.9 14 12 14H36C37.1 14 38 14.9 38 16V20.5C36.2 20.5 34.8 22.1 34.8 24C34.8 25.9 36.2 27.5 38 27.5V32C38 33.1 37.1 34 36 34H12C10.9 34 10 33.1 10 32V27.5C11.8 27.5 13.2 25.9 13.2 24C13.2 22.1 11.8 20.5 10 20.5V16Z" fill="#EAEEF3" />
                  <path d="M10 16C10 14.9 10.9 14 12 14H19V34H12C10.9 34 10 33.1 10 32V27.5C11.8 27.5 13.2 25.9 13.2 24C13.2 22.1 11.8 20.5 10 20.5V16Z" fill="#F05A28" />
                  <line x1="19" y1="16" x2="19" y2="32" stroke="#141920" stroke-width="1.8" stroke-dasharray="2.2 2.2" />
                  <line x1="23.5" y1="21" x2="31.5" y2="21" stroke="#141920" stroke-width="2.2" stroke-linecap="round" />
                  <line x1="23.5" y1="27" x2="29.5" y2="27" stroke="#141920" stroke-width="2.2" stroke-linecap="round" />
                </g>
              </svg>
              <span>Patchwork</span>
            </a>
            <p class="pw-footer-tagline">
              Self-hosted engineering ticketing. No Docker, no seat tiers.
            </p>
            <p class="pw-footer-meta pw-tabular">
              {appMeta.displayVersion} &middot; {appMeta.license} &middot; No cookies, no tracking.
            </p>
          </div>

          <div class="pw-footer-col">
            <h3>Product</h3>
            <ul>
              <li><a href={href("/features/")}>Features</a></li>
              <li><a href={href("/get-started/")}>Get started</a></li>
              <li><a href={href("/documentation/project/roadmap/")}>Roadmap</a></li>
              <li><a href={href("/documentation/changelog/")}>Changelog</a></li>
            </ul>
          </div>

          <div class="pw-footer-col">
            <h3>Documentation</h3>
            <ul>
              <li><a href={href("/documentation/")}>Docs home</a></li>
              <li><a href={href("/documentation/getting-started/quick-start/")}>Quick Start</a></li>
              <li><a href={href("/documentation/admin-guide/system-configuration/")}>System Config</a></li>
              <li><a href={href("/documentation/development/architecture/")}>Architecture</a></li>
            </ul>
          </div>

          <div class="pw-footer-col">
            <h3>Project</h3>
            <ul>
              <li><a href={repoUrl}>GitHub</a></li>
              <li><a href={href("/security/")}>Security</a></li>
              <li><a href={href("/license/")}>License</a></li>
            </ul>
          </div>
        </div>

        <div class="pw-footer-bottom">
          <span class="pw-footer-copy">&copy; {new Date().getFullYear()} Patchwork &middot; {appMeta.license}</span>
          <p class="pw-india-pride">
            <svg class="pw-india-brush" viewBox="0 0 340 54" preserveAspectRatio="none" aria-hidden="true">
              <path d="M10 12 C 75 5, 245 6, 330 11 C 334 14, 326 17, 316 18 C 228 15, 86 16, 14 19 C 6 18, 4 14, 10 12 Z" fill="#FF9933" />
              <path d="M4 21 C 88 16, 248 17, 336 21 C 340 26, 336 33, 328 35 C 236 38, 84 37, 8 34 C 2 31, 0 24, 4 21 Z" fill="#FFFFFF" />
              <path d="M14 36 C 96 33, 250 34, 328 37 C 334 40, 326 44, 316 45 C 230 48, 86 47, 12 43 C 6 41, 8 37, 14 36 Z" fill="#16A34A" />
            </svg>
            <span>Made with love and pride in India</span>
            <svg class="pw-flag-in" width="18" height="12" viewBox="0 0 18 12" role="img" aria-label="Indian flag">
              <rect width="18" height="4" y="0" fill="#FF9933" />
              <rect width="18" height="4" y="4" fill="#FFFFFF" />
              <rect width="18" height="4" y="8" fill="#138808" />
              <circle cx="9" cy="6" r="1.45" fill="none" stroke="#000080" stroke-width="0.45" />
              <circle cx="9" cy="6" r="0.35" fill="#000080" />
            </svg>
          </p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById("pw-theme-toggle");
      const updateLabel = () => {
        if (!toggle) return;
        const curr = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
        const nextLabel = curr === "dark" ? "Switch to light theme" : "Switch to dark theme";
        toggle.setAttribute("aria-label", nextLabel);
        toggle.setAttribute("title", nextLabel);
      };
      updateLabel();
      toggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("patchwork_theme", next);
          localStorage.setItem("starlight-theme", next);
        } catch {}
        updateLabel();
      });

      const headerEl = document.querySelector(".pw-site-header");
      const menuBtn = document.getElementById("pw-menu-toggle");
      const navEl = document.getElementById("pw-primary-nav");
      if (headerEl && menuBtn && navEl) {
        const closeMenu = () => {
          headerEl.classList.remove("is-menu-open");
          menuBtn.setAttribute("aria-expanded", "false");
        };
        menuBtn.addEventListener("click", () => {
          const open = headerEl.classList.toggle("is-menu-open");
          menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
        });
        navEl.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));
        window.addEventListener("keydown", (e) => {
          if (e.key === "Escape") closeMenu();
        });
      }

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const reveals = document.querySelectorAll("[data-pw-reveal]");
      if (reduce || !("IntersectionObserver" in window)) {
        reveals.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08 }
        );
        reveals.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--pw-bg);
    color: var(--pw-ink);
    font-family: var(--pw-font-body);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-family: var(--pw-font-display);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  code,
  pre,
  kbd {
    font-family: var(--pw-font-mono);
  }

  a {
    color: var(--pw-accent);
    text-underline-offset: 3px;
  }

  a:focus-visible,
  button:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--pw-accent);
    outline-offset: 2px;
  }

  .pw-skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--pw-accent);
    color: #ffffff;
    padding: 0.5rem 1rem;
    z-index: 100;
  }
  .pw-skip-link:focus {
    left: 0.75rem;
    top: 0.75rem;
  }

  .pw-container {
    max-width: var(--pw-max-w);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .pw-site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--pw-surface);
    border-bottom: 1px solid var(--pw-border);
  }

  .pw-site-header .pw-container {
    max-width: none;
    width: 100%;
    padding: 0 clamp(1.25rem, 3vw, 2.5rem);
  }

  .pw-header-inner {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    min-height: 60px;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .pw-header-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    order: 2;
  }

  .pw-menu-btn {
    display: none;
    appearance: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 6px;
    border: 0;
    background: transparent;
    color: var(--pw-ink);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .pw-menu-btn:hover {
    background: var(--pw-surface-muted);
    color: var(--pw-accent);
  }

  .pw-menu-btn svg line {
    transition: transform 180ms ease, opacity 180ms ease;
    transform-origin: center;
  }

  .pw-site-header.is-menu-open .pw-burger-top {
    transform: translateY(4px) rotate(45deg);
  }
  .pw-site-header.is-menu-open .pw-burger-mid {
    opacity: 0;
  }
  .pw-site-header.is-menu-open .pw-burger-bot {
    transform: translateY(-4px) rotate(-45deg);
  }

  .pw-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    font-size: 0.9rem;
    order: 1;
    margin-left: auto;
  }

  @media (max-width: 780px) {
    .pw-menu-btn {
      display: inline-flex;
    }

    .pw-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin-left: 0;
      padding: 0.4rem 1.25rem 0.9rem;
      background: var(--pw-surface);
      border-bottom: 1px solid var(--pw-border);
      box-shadow: 0 18px 36px -16px rgba(13, 16, 20, 0.28);
    }

    .pw-site-header.is-menu-open .pw-nav {
      display: flex;
    }

    .pw-nav a {
      width: 100%;
      min-height: 46px;
      padding: 0.5rem 0.25rem;
      border-bottom: 1px solid color-mix(in oklab, var(--pw-border) 55%, transparent);
    }

    .pw-nav a:last-child {
      border-bottom: 0;
    }

    .pw-nav .pw-nav-gh {
      margin-top: 0.5rem;
      justify-content: center;
      border-bottom: 1px solid var(--pw-border);
    }
  }

  .pw-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    font-family: var(--pw-font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--pw-ink);
    text-decoration: none;
  }

  .pw-nav a {
    color: var(--pw-ink);
    text-decoration: none;
    padding: 0.45rem 0.25rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .pw-nav a:hover {
    color: var(--pw-accent);
  }

  .pw-nav-gh {
    gap: 0.4rem;
    justify-content: center;
    line-height: 1;
    padding: 0.35rem 0.55rem !important;
    border-radius: 6px;
    font-weight: 600;
  }

  .pw-nav-gh svg {
    display: block;
    flex-shrink: 0;
  }

  .pw-nav-gh:hover {
    background: var(--pw-surface-muted);
  }

  .pw-nav-star {
    color: #d97706;
  }

  :root[data-theme="dark"] .pw-nav-star {
    color: #f59e0b;
  }

  .pw-theme-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--pw-ink);
    border-radius: 6px;
    padding: 0;
    width: 44px;
    min-height: 44px;
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .pw-theme-sun { display: none; }
  :root[data-theme="dark"] .pw-theme-moon { display: none; }
  :root[data-theme="dark"] .pw-theme-sun { display: block; }

  .pw-theme-btn:hover {
    background: var(--pw-surface-muted);
    color: var(--pw-accent);
  }

  .pw-site-footer {
    border-top: 1px solid var(--pw-border);
    background: var(--pw-surface);
    padding: 3rem 0 2rem;
    margin-top: 4rem;
    font-size: 0.875rem;
    color: var(--pw-ink-secondary);
  }

  .pw-footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, minmax(0, 1fr));
    gap: 2rem 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--pw-border);
  }

  .pw-footer-brand-col .pw-brand {
    margin-bottom: 0.5rem;
  }

  .pw-footer-tagline {
    margin: 0 0 0.5rem;
    max-width: 30ch;
    color: var(--pw-ink-secondary);
    line-height: 1.5;
  }

  .pw-footer-meta {
    margin: 0;
    font-family: var(--pw-font-mono);
    font-size: 0.75rem;
    color: var(--pw-ink-muted);
  }

  .pw-footer-col h3 {
    margin: 0 0 0.75rem;
    font-family: var(--pw-font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--pw-ink-muted);
  }

  .pw-footer-col ul {

---
import "../styles/tokens.css";
import appMeta from "../data/generated/app-meta.json";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = "/" } = Astro.props;
const rawBase = process.env.SITE_BASE || "/";
const basePrefix = rawBase === "/" ? "" : `/${rawBase.replace(/^\/+|\/+$/g, "")}`;
const siteOrigin = (process.env.SITE_URL || "").replace(/\/+$/, "");
const repoUrl = process.env.REPO_URL || appMeta.repositoryUrl;
const canonicalUrl = siteOrigin ? `${siteOrigin}${basePrefix}${canonicalPath}` : undefined;

const href = (p: string) => `${basePrefix}${p}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: appMeta.name,
  softwareVersion: appMeta.displayVersion,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Windows 10, Windows 11, Linux",
  license: `${repoUrl}/blob/main/LICENSE`,
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="manifest" href={href("/site.webmanifest")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={href("/og-image.svg")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      try {
        var t = localStorage.getItem("patchwork_theme") || localStorage.getItem("starlight-theme");
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = t;
        localStorage.setItem("patchwork_theme", t);
        localStorage.setItem("starlight-theme", t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="pw-skip-link" href="#main">Skip to main content</a>
    <header class="pw-site-header">
      <div class="pw-container pw-header-inner">
        <a class="pw-brand" href={href("/")}>
          <svg width="28" height="28" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <rect x="4" y="4" width="40" height="40" rx="8" fill="#141920" />
            <rect x="11" y="11" width="11" height="11" rx="2" fill="#C84317" />
            <rect x="26" y="11" width="11" height="11" rx="2" fill="#EAEEF3" />
            <rect x="11" y="26" width="11" height="11" rx="2" fill="#EAEEF3" opacity="0.78" />
            <rect x="26" y="26" width="11" height="11" rx="2" fill="#F05A28" />
          </svg>
          <span>Patchwork</span>
        </a>
        <nav class="pw-nav" aria-label="Main navigation">
          <a href={href("/features/")}>Features</a>
          <a href={href("/get-started/")}>Get started</a>
          <a href={href("/documentation/")}>Documentation</a>
          <a href={href("/documentation/project/roadmap/")}>Roadmap</a>
          <a href={href("/documentation/changelog/")}>Changelog</a>
          <a href={repoUrl} class="pw-nav-gh">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z" />
            </svg>
            <span>GitHub</span>
          </a>
          <button type="button" class="pw-theme-btn" id="pw-theme-toggle">
            Theme
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="pw-site-footer">
      <div class="pw-container pw-footer-inner">
        <div>
          <strong>Patchwork</strong> · <span class="pw-tabular">{appMeta.displayVersion}</span> · {appMeta.license} · No cookies, no tracking.
        </div>
        <div class="pw-footer-links">
          <a href={href("/documentation/")}>Documentation</a>
          <a href={href("/documentation/project/roadmap/")}>Roadmap</a>
          <a href={href("/documentation/changelog/")}>Changelog</a>
          <a href={href("/security/")}>Security</a>
          <a href={href("/license/")}>License</a>
          <a href={repoUrl}>GitHub</a>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById("pw-theme-toggle");
      const updateLabel = () => {
        if (!toggle) return;
        const curr = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
        const nextLabel = curr === "dark" ? "Light" : "Dark";
        toggle.textContent = nextLabel;
        toggle.setAttribute("aria-label", `${nextLabel} theme`);
      };
      updateLabel();
      toggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("patchwork_theme", next);
          localStorage.setItem("starlight-theme", next);
        } catch {}
        updateLabel();
      });

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const reveals = document.querySelectorAll("[data-pw-reveal]");
      if (reduce || !("IntersectionObserver" in window)) {
        reveals.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08 }
        );
        reveals.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--pw-bg);
    color: var(--pw-ink);
    font-family: var(--pw-font-body);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-family: var(--pw-font-display);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  code,
  pre,
  kbd {
    font-family: var(--pw-font-mono);
  }

  a {
    color: var(--pw-accent);
    text-underline-offset: 3px;
  }

  a:focus-visible,
  button:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--pw-accent);
    outline-offset: 2px;
  }

  .pw-skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--pw-accent);
    color: #ffffff;
    padding: 0.5rem 1rem;
    z-index: 100;
  }
  .pw-skip-link:focus {
    left: 0.75rem;
    top: 0.75rem;
  }

  .pw-container {
    max-width: var(--pw-max-w);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .pw-site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--pw-surface);
    border-bottom: 1px solid var(--pw-border);
  }

  .pw-header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    min-height: 60px;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .pw-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--pw-font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--pw-ink);
    text-decoration: none;
  }

  .pw-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.9rem;
    font-size: 0.9rem;
  }

  .pw-nav a {
    color: var(--pw-ink);
    text-decoration: none;
    padding: 0.45rem 0.25rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .pw-nav a:hover {
    color: var(--pw-accent);
  }

  .pw-nav-gh {
    gap: 0.35rem;
  }

  .pw-theme-btn {
    appearance: none;
    border: 1px solid var(--pw-border);
    background: var(--pw-bg);
    color: var(--pw-ink);
    border-radius: var(--pw-radius-sm);
    padding: 0.35rem 0.75rem;
    min-height: 44px;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }

  .pw-theme-btn:hover {
    border-color: var(--pw-accent);
  }

  .pw-site-footer {
    border-top: 1px solid var(--pw-border);
    background: var(--pw-surface);
    padding: 2rem 0;
    margin-top: 4rem;
    font-size: 0.875rem;
    color: var(--pw-ink-secondary);
  }

  .pw-footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
  }

  .pw-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .pw-footer-links a {
    color: var(--pw-ink);
  }

  [data-pw-reveal] {
    opacity: 1;
    transform: none;
  }
</style>

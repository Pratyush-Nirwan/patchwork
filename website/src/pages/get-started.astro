---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import appMeta from "../data/generated/app-meta.json";

const rawBase = process.env.SITE_BASE || "/";
const basePrefix = rawBase === "/" ? "" : `/${rawBase.replace(/^\/+|\/+$/g, "")}`;
const href = (p: string) => `${basePrefix}${p}`;
const heroWords = "Running in three steps.".split(" ");
const cloneSnippet = `git clone ${appMeta.cloneUrl}\ncd patchwork\nnpm ci`;
---

<MarketingLayout
  title={`Get started — Patchwork ${appMeta.displayVersion}`}
  description="Install Patchwork in three steps on Windows and Linux with only Node.js and git."
  canonicalPath="/get-started/"
>
  <div class="pw-scroll-progress" aria-hidden="true">
    <div class="pw-scroll-progress-bar" data-pw-scroll-progress></div>
  </div>

  <section class="pw-subhero">
    <div class="pw-subhero-ambient" aria-hidden="true">
      <div class="pw-subhero-grid-bg"></div>
      <div class="pw-subhero-glow"></div>
    </div>

    <div class="pw-container pw-subhero-inner">
      <p class="pw-eyebrow pw-tabular" data-pw-stagger="0">
        Native Install &middot; {appMeta.displayVersion} &middot; Node.js {appMeta.nodeRequirement} + git
      </p>
      <h1 class="pw-subhero-h1" aria-label="Running in three steps.">
        {heroWords.map((w, i) => (
          <span class="pw-h1-clip">
            <span class="pw-h1-word" style={`--wi:${i}`}>{w}</span>
          </span>
        ))}
      </h1>
      <p class="pw-lead" data-pw-stagger="2">
        No Docker daemon or container registry. Choose Easy mode for automatic PostgreSQL and MinIO,
        or Advanced mode to connect your existing services.
      </p>

      <div class="pw-mode-switch" role="group" aria-label="Install mode" data-pw-stagger="3">
        <button type="button" class="is-active" data-install-mode="easy">Easy mode (Recommended)</button>
        <button type="button" data-install-mode="advanced">Advanced mode (Existing DB + MinIO)</button>
      </div>
    </div>
  </section>

  <section class="pw-section">
    <div class="pw-container pw-gs-grid">
      <div class="pw-gs-sticky">
        <p class="pw-gs-kicker">Three-step setup</p>
        <h2>Native on Windows &amp; Linux.</h2>
        <p class="pw-gs-sub" data-mode-summary>
          Easy mode checks prerequisites, initializes PostgreSQL 18 in <code>./data/postgres</code>,
          and downloads a SHA-256 verified MinIO binary.
        </p>
        <div class="pw-os-pills" role="group" aria-label="Operating system">
          <button type="button" class="is-active" data-os="win">Windows (PowerShell)</button>
          <button type="button" data-os="linux">Linux (bash)</button>
        </div>
      </div>

      <div class="pw-gs-rail">
        <article class="pw-gs-beat is-active" data-pw-beat>
          <div class="pw-beat-head">
            <span class="pw-beat-num">Step 01</span>
            <button type="button" class="pw-copy-btn" data-copy-text={cloneSnippet}>Copy</button>
          </div>
          <h3>Clone and install dependencies</h3>
          <div class="pw-terminal">
            <pre><code><span class="pw-tok-cmd">git</span> clone {appMeta.cloneUrl}
<span class="pw-tok-cmd">cd</span> patchwork
<span class="pw-tok-cmd">npm</span> ci</code></pre>
          </div>
        </article>

        <article class="pw-gs-beat" data-pw-beat>
          <div class="pw-beat-head">
            <span class="pw-beat-num">Step 02</span>
            <button type="button" class="pw-copy-btn" data-copy-setup data-copy-text="npm run setup">Copy</button>
          </div>
          <h3>Run the interactive installer</h3>
          <div class="pw-terminal">
            <pre><code data-setup-cmd><span class="pw-tok-cmd">npm</span> run setup<span class="pw-term-cursor" aria-hidden="true"></span></code></pre>
          </div>
          <p data-setup-desc>
            Select <strong>Easy (recommended)</strong> to provision PostgreSQL and MinIO automatically,
            run migrations, and generate your encrypted one-time Admin Setup Token.
          </p>
        </article>

        <article class="pw-gs-beat" data-pw-beat>
          <div class="pw-beat-head">
            <span class="pw-beat-num">Step 03</span>
            <span class="pw-beat-tag" data-os-note>Windows 10/11</span>
          </div>
          <h3>Complete the browser Setup Wizard</h3>
          <p>
            Open <code>http://localhost:3000/setup</code>, paste your one-time Admin Setup Token,
            and create your admin account and initial organization.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="pw-section pw-section-alt" data-pw-reveal>
    <div class="pw-container">
      <div class="pw-section-head">
        <h2>Day-two operations</h2>
        <a href={href("/documentation/getting-started/quick-start/")}>Full Quick Start docs &rarr;</a>
      </div>
      <div class="pw-ops-grid">
        <div class="pw-op-cell">
          <code>npm run start</code>
          <p>Start the production server and background worker.</p>
        </div>
        <div class="pw-op-cell">
          <code>npm run status</code>
          <p>Check database, MinIO bucket, and service health.</p>
        </div>
        <div class="pw-op-cell">
          <code>npm run setup -- --repair</code>
          <p>Non-destructively repair missing services or env keys.</p>
        </div>
        <div class="pw-op-cell">
          <code>npm run stop</code>
          <p>Gracefully stop managed native services.</p>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .pw-scroll-progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 100; pointer-events: none; }
  .pw-scroll-progress-bar { height: 100%; width: 100%; background: var(--pw-accent); transform-origin: 0 50%; transform: scaleX(0); will-change: transform; }

  .pw-subhero { position: relative; overflow: hidden; padding: clamp(4rem, 7vw, 6.5rem) 0 clamp(3rem, 5vw, 4.5rem); border-bottom: 1px solid var(--pw-border); }
  .pw-subhero-ambient { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .pw-subhero-grid-bg { position: absolute; inset: -48px; background-image: linear-gradient(to right, var(--pw-border) 1px, transparent 1px), linear-gradient(to bottom, var(--pw-border) 1px, transparent 1px); background-size: 48px 48px; opacity: 0.45; mask-image: radial-gradient(ellipse 80% 70% at 50% 20%, #000 35%, transparent 100%); animation: pw-grid-drift 28s linear infinite; }
  .pw-subhero-glow { position: absolute; top: -180px; left: 50%; width: min(860px, 110vw); height: 420px; transform: translateX(-50%); background: radial-gradient(circle, color-mix(in oklab, var(--pw-accent) 20%, transparent) 0%, transparent 68%); }
  @keyframes pw-grid-drift { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(48px, 48px, 0); } }

  .pw-subhero-inner { position: relative; z-index: 1; }
  .pw-eyebrow { margin: 0 0 0.85rem; font-family: var(--pw-font-mono); font-size: 0.78rem; color: var(--pw-accent); }
  .pw-subhero-h1 { font-size: clamp(2.3rem, 4.8vw, 3.9rem); line-height: 1.06; letter-spacing: -0.03em; margin: 0 0 1rem; display: flex; flex-wrap: wrap; column-gap: 0.28em; }
  .pw-h1-clip { display: inline-block; overflow: hidden; padding-bottom: 0.06em; }
  .pw-h1-word { display: inline-block; transform: translate3d(0, 110%, 0); opacity: 0; animation: pw-word-rise 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards; animation-delay: calc(60ms + var(--wi, 0) * 50ms); }
  @keyframes pw-word-rise { to { transform: translate3d(0, 0, 0); opacity: 1; } }

  .pw-lead { font-size: clamp(1.02rem, 1.3vw, 1.15rem); color: var(--pw-ink-secondary); max-width: 56ch; margin: 0 0 1.75rem; }
  [data-pw-stagger] { opacity: 0; transform: translate3d(0, 14px, 0); animation: pw-rise 680ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  [data-pw-stagger="0"] { animation-delay: 40ms; }
  [data-pw-stagger="2"] { animation-delay: 180ms; }
  [data-pw-stagger="3"] { animation-delay: 260ms; }
  @keyframes pw-rise { to { opacity: 1; transform: translate3d(0, 0, 0); } }

  .pw-mode-switch, .pw-os-pills { display: inline-flex; flex-wrap: wrap; gap: 0.45rem; }
  .pw-mode-switch button, .pw-os-pills button {
    font-family: var(--pw-font-mono); font-size: 0.78rem; padding: 0.45rem 0.85rem;
    border-radius: 999px; border: 1px solid var(--pw-border); background: var(--pw-surface);
    color: var(--pw-ink-secondary); cursor: pointer; min-height: 36px;
    transition: border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }
  .pw-mode-switch button.is-active, .pw-os-pills button.is-active { border-color: var(--pw-accent); color: var(--pw-accent); font-weight: 600; }

  .pw-section { padding: clamp(4.5rem, 7.5vw, 6.5rem) 0; }
  .pw-section-alt { background: var(--pw-surface); border-top: 1px solid var(--pw-border); border-bottom: 1px solid var(--pw-border); }
  .pw-section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.75rem; margin-bottom: 2rem; }
  .pw-section-head a { color: var(--pw-accent); text-decoration: none; font-weight: 600; }

  .pw-gs-grid { display: grid; grid-template-columns: 0.82fr 1.18fr; gap: clamp(2.5rem, 5vw, 5rem); align-items: start; }
  .pw-gs-sticky { position: sticky; top: 5.5rem; }
  .pw-gs-kicker { margin: 0 0 0.6rem; font-family: var(--pw-font-mono); font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--pw-accent); }
  .pw-gs-sticky h2 { margin: 0 0 0.85rem; font-size: clamp(1.65rem, 2.8vw, 2.25rem); }
  .pw-gs-sub { color: var(--pw-ink-secondary); line-height: 1.6; margin: 0 0 1.25rem; max-width: 40ch; }

  .pw-gs-rail { display: grid; gap: 2.75rem; border-left: 1px solid var(--pw-border); padding-left: clamp(1.5rem, 3vw, 2.5rem); }
  .pw-gs-beat { position: relative; padding-bottom: 2rem; border-bottom: 1px solid color-mix(in oklab, var(--pw-border) 55%, transparent); opacity: 0.58; transition: opacity 280ms ease; }
  .pw-gs-beat::before { content: ""; position: absolute; left: calc(-1 * clamp(1.5rem, 3vw, 2.5rem) - 1.5px); top: 0.3rem; width: 3px; height: 1.4rem; background: var(--pw-accent); transform: scaleY(0); transform-origin: top; transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1); }
  .pw-gs-beat.is-active { opacity: 1; }
  .pw-gs-beat.is-active::before { transform: scaleY(1); }
  .pw-gs-beat:last-child { border-bottom: 0; padding-bottom: 0; }
  .pw-beat-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.55rem; }
  .pw-beat-num { font-family: var(--pw-font-mono); font-size: 0.76rem; color: var(--pw-accent); font-weight: 600; }
  .pw-beat-tag { font-family: var(--pw-font-mono); font-size: 0.74rem; color: var(--pw-ink-muted); }
  .pw-gs-beat h3 { margin: 0 0 0.75rem; font-size: 1.2rem; }
  .pw-gs-beat p { margin: 0.75rem 0 0; color: var(--pw-ink-secondary); }

  .pw-copy-btn { background: var(--pw-surface); color: var(--pw-ink-secondary); border: 1px solid var(--pw-border); border-radius: 4px; padding: 0.2rem 0.6rem; font-family: var(--pw-font-mono); font-size: 0.72rem; cursor: pointer; }
  .pw-terminal { background: var(--pw-rail-bg); color: var(--pw-rail-ink); border-radius: var(--pw-radius-md); border: 1px solid #28313e; padding: 0.9rem 1rem; overflow-x: auto; }
  .pw-terminal pre { margin: 0; font-family: var(--pw-font-mono); font-size: 0.82rem; line-height: 1.6; }
  .pw-tok-cmd { color: #ff8a61; font-weight: 500; }
  .pw-term-cursor { display: inline-block; width: 7px; height: 1em; margin-left: 5px; vertical-align: -2px; background: var(--pw-accent); animation: pw-cursor-blink 1.05s steps(2, start) infinite; }
  @keyframes pw-cursor-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }

  .pw-ops-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--pw-border); }
  .pw-op-cell { padding: 1.5rem 1.25rem; border-bottom: 1px solid var(--pw-border); border-right: 1px solid var(--pw-border); }
  .pw-op-cell:last-child { border-right: 0; }
  .pw-op-cell code { font-family: var(--pw-font-mono); font-size: 0.84rem; color: var(--pw-accent); font-weight: 600; }
  .pw-op-cell p { margin: 0.5rem 0 0; font-size: 0.9rem; color: var(--pw-ink-secondary); }

  @media (max-width: 900px) {
    .pw-gs-grid { grid-template-columns: 1fr; }
    .pw-gs-sticky { position: static; }
    .pw-gs-beat { opacity: 1; }
    .pw-ops-grid { grid-template-columns: 1fr 1fr; }
    .pw-op-cell:nth-child(2n) { border-right: 0; }
  }
  @media (max-width: 540px) {
    .pw-ops-grid { grid-template-columns: 1fr; }
    .pw-op-cell { border-right: 0; }
  }

  [data-pw-reveal] { opacity: 0; transform: translate3d(0, 18px, 0); transition: opacity 540ms cubic-bezier(0.16, 1, 0.3, 1), transform 540ms cubic-bezier(0.16, 1, 0.3, 1); }
  [data-pw-reveal].is-visible { opacity: 1; transform: translate3d(0, 0, 0); }

  @media (prefers-reduced-motion: reduce) {
    .pw-subhero-grid-bg, .pw-h1-word, .pw-term-cursor, [data-pw-stagger], [data-pw-reveal] { animation: none !important; transition: none !important; opacity: 1 !important; transform: none !important; }
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const bar = document.querySelector("[data-pw-scroll-progress]") as HTMLElement | null;
  if (bar && !reduced) {
    let cur = 0; let raf = 0;
    const step = () => {
      const docH = document.documentElement.scrollHeight - window.innerHeight;
      const target = docH > 0 ? Math.max(0, Math.min(1, window.scrollY / docH)) : 0;
      cur += (target - cur) * 0.18;
      bar.style.transform = `scaleX(${cur.toFixed(4)})`;
      raf = Math.abs(target - cur) > 0.0005 ? requestAnimationFrame(step) : 0;
    };
    window.addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(step); }, { passive: true });
    step();
  }

  document.querySelectorAll("[data-copy-text]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy-text") || "";
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "Copied";
        setTimeout(() => { btn.textContent = "Copy"; }, 1600);
      } catch {}
    });
  });

  const modeBtns = [...document.querySelectorAll("[data-install-mode]")];
  const setupCmdEl = document.querySelector("[data-setup-cmd]");
  const copySetupBtn = document.querySelector("[data-copy-setup]");
  const setupDescEl = document.querySelector("[data-setup-desc]");
  const modeSummaryEl = document.querySelector("[data-mode-summary]");
  modeBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const mode = btn.getAttribute("data-install-mode");
      modeBtns.forEach((b) => b.classList.toggle("is-active", b === btn));
      const isAdv = mode === "advanced";
      const cmd = isAdv ? "npm run setup -- --advanced" : "npm run setup";
      if (setupCmdEl) setupCmdEl.innerHTML = `<span class="pw-tok-cmd">npm</span> ${isAdv ? "run setup -- --advanced" : "run setup"}<span class="pw-term-cursor" aria-hidden="true"></span>`;
      if (copySetupBtn) copySetupBtn.setAttribute("data-copy-text", cmd);
      if (setupDescEl) setupDescEl.innerHTML = isAdv
        ? "Connect your existing PostgreSQL 16+ database and MinIO S3 endpoint, run migrations, and generate your encrypted Admin Setup Token."
        : "Select <strong>Easy (recommended)</strong> to provision PostgreSQL and MinIO automatically, run migrations, and generate your encrypted one-time Admin Setup Token.";
      if (modeSummaryEl) modeSummaryEl.innerHTML = isAdv
        ? "Advanced mode connects to your existing PostgreSQL 16+ and MinIO instances without downloading local binaries."
        : "Easy mode checks prerequisites, initializes PostgreSQL 18 in <code>./data/postgres</code>, and downloads a SHA-256 verified MinIO binary.";
    });
  });

  const osBtns = [...document.querySelectorAll("[data-os]")];
  const osNote = document.querySelector("[data-os-note]");
  osBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      osBtns.forEach((b) => b.classList.toggle("is-active", b === btn));
      if (osNote) osNote.textContent = btn.getAttribute("data-os") === "linux" ? "Ubuntu / Debian (x64 & arm64)" : "Windows 10/11 (PowerShell)";
    });
  });

  const beats = [...document.querySelectorAll("[data-pw-beat]")];
  if (beats.length > 0 && "IntersectionObserver" in window) {
    const bObs = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          beats.forEach((b) => b.classList.remove("is-active"));
          e.target.classList.add("is-active");
        }
      }
    }, { rootMargin: "-30% 0px -45% 0px", threshold: 0.1 });
    beats.forEach((b) => bObs.observe(b));
  }

  const revealEls = [...document.querySelectorAll("[data-pw-reveal]")];
  if (reduced || !("IntersectionObserver" in window)) {
    revealEls.forEach((el) => el.classList.add("is-visible"));
  } else {
    const obs = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add("is-visible"); obs.unobserve(e.target); }
      }
    }, { rootMargin: "0px 0px -8% 0px", threshold: 0.06 });
    revealEls.forEach((el) => obs.observe(el));
  }
</script>

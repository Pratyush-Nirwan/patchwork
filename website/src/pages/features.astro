---
import fs from "node:fs";
import path from "node:path";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import appMeta from "../data/generated/app-meta.json";

const raw = fs.readFileSync(path.resolve("src/data/features.yaml"), "utf8");
const areas: Array<{ id: string; title: string; description: string; items: Array<{ id: string; title: string; summary: string }> }> = [];
let curArea: (typeof areas)[number] | null = null;
let curItem: (typeof areas)[number]["items"][number] | null = null;
for (const line of raw.split(/\r?\n/)) {
  const mAreaId = line.match(/^\s{2}-\s*id:\s*"([^"]+)"/);
  if (mAreaId) {
    curArea = { id: mAreaId[1], title: "", description: "", items: [] };
    areas.push(curArea);
    curItem = null;
    continue;
  }
  const mItemId = line.match(/^\s{6}-\s*id:\s*"([^"]+)"/);
  if (mItemId && curArea) {
    curItem = { id: mItemId[1], title: "", summary: "" };
    curArea.items.push(curItem);
    continue;
  }
  const kv = line.match(/^\s+(title|description|summary):\s*"([^"]+)"/);
  if (kv) {
    if (curItem && (kv[1] === "title" || kv[1] === "summary")) curItem[kv[1]] = kv[2];
    else if (curArea && (kv[1] === "title" || kv[1] === "description")) curArea[kv[1]] = kv[2];
  }
}

const rawBase = process.env.SITE_BASE || "/";
const basePrefix = rawBase === "/" ? "" : `/${rawBase.replace(/^\/+|\/+$/g, "")}`;
const href = (p: string) => `${basePrefix}${p}`;
const heroWords = `Everything in ${appMeta.displayVersion}`.split(" ");
---

<MarketingLayout
  title={`Features — Patchwork ${appMeta.displayVersion}`}
  description="Verified capabilities available today in Patchwork: Kanban boards, tickets, scoped search, command bar, RBAC, and native install."
  canonicalPath="/features/"
  ogImage="/og-features.png"
  ogImageAlt="Patchwork Features — Real-time Kanban, Command Bar, and MinIO attachments."
>
  <div class="pw-scroll-progress" aria-hidden="true">
    <div class="pw-scroll-progress-bar" data-pw-scroll-progress></div>
  </div>

  <section class="pw-subhero">
    <div class="pw-subhero-ambient" aria-hidden="true">
      <div class="pw-subhero-grid-bg"></div>
      <div class="pw-subhero-glow"></div>
    </div>
    <div class="pw-container pw-subhero-inner">
      <h1 class="pw-subhero-h1" aria-label={`Everything in ${appMeta.displayVersion}`}>
        {heroWords.map((w, i) => (
          <span class="pw-h1-clip">
            <span class="pw-h1-word" style={`--wi:${i}`}>{w}</span>
          </span>
        ))}
      </h1>
      <p class="pw-lead" data-pw-stagger="2">
        Every feature is built and tested. Nothing is paywalled.
      </p>

      <nav class="pw-jump-nav" aria-label="Feature categories" data-pw-stagger="3">
        {areas.map((area, idx) => (
          <a href={`#${area.id}`} class="pw-jump-pill" data-jump-id={area.id}>
            <span class="pw-tabular">{String(idx + 1).padStart(2, "0")}</span>
            <span>{area.title}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <div class="pw-container pw-areas-wrap">
    {areas.map((area, areaIdx) => (
      <section class="pw-area-row" id={area.id} data-pw-area-section data-pw-reveal>
        <div class="pw-area-sticky">
          <span class="pw-area-num pw-tabular">{String(areaIdx + 1).padStart(2, "0")}</span>
          <h2>{area.title}</h2>
          <p class="pw-area-desc">{area.description}</p>
        </div>

        <div class="pw-area-items">
          {area.items.map((item, itemIdx) => (
            <article class="pw-item-line" style={`--ii:${itemIdx}`} data-pw-reveal>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <section class="pw-sub-cta" data-pw-reveal>
    <div class="pw-container pw-sub-cta-inner">
      <div>
        <h2>Ready to self-host?</h2>
        <p>Install on Windows or Linux in three steps.</p>
      </div>
      <div class="pw-cta-row">
        <a class="pw-btn pw-btn-primary" href={href("/get-started/")}>Get started</a>
        <a class="pw-btn pw-btn-secondary" href={href("/documentation/project/roadmap/")}>View v1.0.0 Roadmap</a>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .pw-scroll-progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 100; pointer-events: none; }
  .pw-scroll-progress-bar { height: 100%; width: 100%; background: var(--pw-accent); transform-origin: 0 50%; transform: scaleX(0); will-change: transform; }

  .pw-subhero { position: relative; overflow: hidden; padding: clamp(4rem, 7vw, 6.5rem) 0 clamp(3rem, 5vw, 4.5rem); border-bottom: 1px solid var(--pw-border); }
  .pw-subhero-ambient { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .pw-subhero-grid-bg { position: absolute; inset: -48px; background-image: linear-gradient(to right, var(--pw-border) 1px, transparent 1px), linear-gradient(to bottom, var(--pw-border) 1px, transparent 1px); background-size: 48px 48px; opacity: 0.45; mask-image: radial-gradient(ellipse 80% 70% at 50% 20%, #000 35%, transparent 100%); animation: pw-grid-drift 28s linear infinite; }
  .pw-subhero-glow { position: absolute; top: -180px; left: 50%; width: min(860px, 110vw); height: 420px; transform: translateX(-50%); background: radial-gradient(circle, color-mix(in oklab, var(--pw-accent) 20%, transparent) 0%, transparent 68%); }
  @keyframes pw-grid-drift { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(48px, 48px, 0); } }

  .pw-subhero-inner { position: relative; z-index: 1; }
  .pw-eyebrow { margin: 0 0 0.85rem; font-family: var(--pw-font-mono); font-size: 0.78rem; color: var(--pw-accent); letter-spacing: 0.04em; }
  .pw-subhero-h1 { font-size: clamp(2.3rem, 4.8vw, 3.9rem); line-height: 1.06; letter-spacing: -0.03em; margin: 0 0 1rem; display: flex; flex-wrap: wrap; column-gap: 0.28em; }
  .pw-h1-clip { display: inline-block; overflow: hidden; padding-bottom: 0.06em; }
  .pw-h1-word { display: inline-block; transform: translate3d(0, 110%, 0); opacity: 0; animation: pw-word-rise 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards; animation-delay: calc(60ms + var(--wi, 0) * 50ms); }
  @keyframes pw-word-rise { to { transform: translate3d(0, 0, 0); opacity: 1; } }

  .pw-lead { font-size: clamp(1.02rem, 1.3vw, 1.15rem); color: var(--pw-ink-secondary); max-width: 58ch; margin: 0 0 2rem; }
  [data-pw-stagger] { opacity: 0; transform: translate3d(0, 14px, 0); animation: pw-rise 680ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  [data-pw-stagger="0"] { animation-delay: 40ms; }
  [data-pw-stagger="2"] { animation-delay: 180ms; }
  [data-pw-stagger="3"] { animation-delay: 260ms; }
  @keyframes pw-rise { to { opacity: 1; transform: translate3d(0, 0, 0); } }

  .pw-jump-nav { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .pw-jump-pill { display: inline-flex; align-items: center; gap: 0.45rem; min-height: 44px; padding: 0.45rem 0.9rem; border-radius: 999px; border: 1px solid var(--pw-border); background: var(--pw-surface); color: var(--pw-ink-secondary); text-decoration: none; font-size: 0.82rem; font-weight: 500; transition: border-color 180ms ease, color 180ms ease, transform 180ms ease; }
  .pw-jump-pill:hover, .pw-jump-pill.is-active { border-color: var(--pw-accent); color: var(--pw-accent); transform: translateY(-1px); }
  .pw-jump-pill span:first-child { font-family: var(--pw-font-mono); font-size: 0.72rem; opacity: 0.75; }

  .pw-areas-wrap { padding: clamp(2rem, 4vw, 3.5rem) 0; }
  .pw-area-row { display: grid; grid-template-columns: 0.82fr 1.18fr; gap: clamp(2rem, 5vw, 4.5rem); padding: clamp(3rem, 5vw, 4.5rem) 0; border-bottom: 1px solid var(--pw-border); align-items: start; scroll-margin-top: 5rem; }
  .pw-area-row:last-child { border-bottom: 0; }
  .pw-area-sticky { position: sticky; top: 5.5rem; }
  .pw-area-num { display: inline-block; font-family: var(--pw-font-mono); font-size: 0.78rem; color: var(--pw-accent); margin-bottom: 0.5rem; }
  .pw-area-sticky h2 { margin: 0 0 0.75rem; font-size: clamp(1.5rem, 2.5vw, 2rem); line-height: 1.15; }
  .pw-area-desc { margin: 0; color: var(--pw-ink-secondary); line-height: 1.6; max-width: 40ch; }

  .pw-area-items { display: grid; border-top: 1px solid var(--pw-border); }
  .pw-item-line { padding: 1.35rem 0.5rem; border-bottom: 1px solid color-mix(in oklab, var(--pw-border) 65%, transparent); transition: background-color 200ms ease, padding-left 220ms cubic-bezier(0.16, 1, 0.3, 1); }
  .pw-item-line:hover { background: color-mix(in oklab, var(--pw-surface-muted) 45%, transparent); padding-left: 1rem; }
  .pw-item-line h3 { margin: 0 0 0.35rem; font-size: 1.06rem; }
  .pw-item-line p { margin: 0; font-size: 0.94rem; color: var(--pw-ink-secondary); line-height: 1.55; }

  @media (max-width: 860px) {
    .pw-area-row { grid-template-columns: 1fr; padding: 2.25rem 0; gap: 1.5rem; }
    .pw-area-sticky { position: static; }
  }
  @media (max-width: 720px) {
    .pw-subhero { padding: 2.25rem 0 1.75rem; }
    .pw-jump-nav { flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding-bottom: 0.25rem; }
    .pw-jump-nav::-webkit-scrollbar { display: none; }
    .pw-jump-pill { flex-shrink: 0; }
    .pw-item-line { padding: 1.1rem 0; }
    .pw-item-line:hover { padding-left: 0; background: transparent; }
  }
  @media (max-width: 520px) {
    .pw-cta-row { width: 100%; flex-direction: column; }
    .pw-btn { width: 100%; justify-content: center; }
  }

  .pw-sub-cta { border-top: 1px solid var(--pw-border); background: var(--pw-surface); padding: clamp(3.5rem, 6vw, 5rem) 0; }
  .pw-sub-cta-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .pw-sub-cta h2 { margin: 0 0 0.35rem; }
  .pw-sub-cta p { margin: 0; color: var(--pw-ink-secondary); }
  .pw-cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .pw-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0.6rem 1.2rem; border-radius: var(--pw-radius-sm); font-weight: 600; text-decoration: none; border: 1px solid transparent; transition: transform 180ms ease; }
  .pw-btn:hover { transform: translateY(-1px); }
  .pw-btn-primary { background: var(--pw-accent); color: #fff; }
  :root[data-theme="dark"] .pw-btn-primary { color: #0d1014; }
  .pw-btn-secondary { background: var(--pw-bg); color: var(--pw-ink); border-color: var(--pw-border); }

  [data-pw-reveal] { opacity: 0; transform: translate3d(0, 18px, 0); transition: opacity 540ms cubic-bezier(0.16, 1, 0.3, 1), transform 540ms cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--ii, 0) * 45ms); }
  [data-pw-reveal].is-visible { opacity: 1; transform: translate3d(0, 0, 0); }

  @media (prefers-reduced-motion: reduce) {
    .pw-subhero-grid-bg, .pw-h1-word, [data-pw-stagger], [data-pw-reveal] { animation: none !important; transition: none !important; opacity: 1 !important; transform: none !important; }
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const bar = document.querySelector("[data-pw-scroll-progress]") as HTMLElement | null;
  if (bar && !reduced) {
    let cur = 0; let raf = 0;
    const step = () => {
      const docH = document.documentElement.scrollHeight - window.innerHeight;
      const target = docH > 0 ? Math.max(0, Math.min(1, window.scrollY / docH)) : 0;
      cur += (target - cur) * 0.18;
      bar.style.transform = `scaleX(${cur.toFixed(4)})`;
      raf = Math.abs(target - cur) > 0.0005 ? requestAnimationFrame(step) : 0;
    };
    window.addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(step); }, { passive: true });
    step();
  }

  const revealEls = [...document.querySelectorAll("[data-pw-reveal]")];
  if (reduced || !("IntersectionObserver" in window)) {
    revealEls.forEach((el) => el.classList.add("is-visible"));
  } else {
    const obs = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add("is-visible"); obs.unobserve(e.target); }
      }
    }, { rootMargin: "0px 0px -8% 0px", threshold: 0.06 });
    revealEls.forEach((el) => obs.observe(el));
  }

  const pills = [...document.querySelectorAll("[data-jump-id]")];
  const sections = [...document.querySelectorAll("[data-pw-area-section]")];
  if (sections.length > 0 && "IntersectionObserver" in window) {
    const navObs = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          const id = e.target.getAttribute("id");
          pills.forEach((p) => p.classList.toggle("is-active", p.getAttribute("data-jump-id") === id));
        }
      }
    }, { rootMargin: "-30% 0px -55% 0px" });
    sections.forEach((s) => navObs.observe(s));
  }
</script>

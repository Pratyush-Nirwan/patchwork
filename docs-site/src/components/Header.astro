---
import Default from "@astrojs/starlight/components/Header.astro";

const rawBase = process.env.DOCS_BASE ?? "/documentation";
const isEmbedded =
  process.env.DOCS_EMBEDDED !== "false" &&
  rawBase.replace(/^\/+|\/+$/g, "") === "documentation";
---

<div class="pw-header-wrap">
  <Default {...Astro.props} />
  {
    isEmbedded && (
      <a href="/" class="pw-back-to-app">
        Back to Patchwork
      </a>
    )
  }
</div>

<style>
  .pw-header-wrap {
    display: contents;
  }
  .pw-back-to-app {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    border-radius: 4px;
    border: 1px solid var(--sl-color-hairline-light);
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }
  .pw-back-to-app:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text-accent);
  }
</style>

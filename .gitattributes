# Enforce LF line endings across all platforms by default
* text=auto eol=lf

# Explicit LF for code, config, scripts, SQL, and docs
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.service text eol=lf
*.conf text eol=lf
Caddyfile text eol=lf
.env.example text eol=lf

# Windows batch scripts (if any)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.exe binary
bin/* binary


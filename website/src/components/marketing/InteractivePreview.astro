---
import { Image } from "astro:assets";
import boardLight from "../../assets/screenshots/board-light.png";
import boardDark from "../../assets/screenshots/board-dark.png";
---

<div class="pw-preview-shell" data-pw-preview>
  <div class="pw-preview-bar">
    <span class="pw-preview-badge">Interactive preview · Sample data</span>
    <div class="pw-preview-actions">
      <button type="button" class="pw-cmd-trigger" id="pw-preview-cmd-btn">
        Command bar <kbd>Ctrl+K</kbd>
      </button>
    </div>
  </div>

  <div class="pw-preview-board" id="pw-preview-board" hidden>
    <div class="pw-preview-col" data-col="new">
      <div class="pw-col-head"><span>New</span><span class="pw-tabular" data-col-count>1</span></div>
      <div class="pw-col-list">
        <article class="pw-card" draggable="true" tabindex="0" data-card-id="API-14">
          <div class="pw-card-key">API-14 · <span class="pw-prio-high">high</span></div>
          <div class="pw-card-title">Add SSE reconnect backoff</div>
          <div class="pw-card-controls">
            <button type="button" data-move="prev" aria-label="Move API-14 left">&larr;</button>
            <button type="button" data-move="next" aria-label="Move API-14 right">&rarr;</button>
          </div>
        </article>
      </div>
    </div>

    <div class="pw-preview-col" data-col="progress">
      <div class="pw-col-head"><span>In Progress</span><span class="pw-tabular" data-col-count>1</span></div>
      <div class="pw-col-list">
        <article class="pw-card" draggable="true" tabindex="0" data-card-id="CORE-8">
          <div class="pw-card-key">CORE-8 · <span class="pw-prio-urgent">urgent</span></div>
          <div class="pw-card-title">Index PDF attachments in FTS</div>
          <div class="pw-card-controls">
            <button type="button" data-move="prev" aria-label="Move CORE-8 left">&larr;</button>
            <button type="button" data-move="next" aria-label="Move CORE-8 right">&rarr;</button>
          </div>
        </article>
      </div>
    </div>

    <div class="pw-preview-col" data-col="review">
      <div class="pw-col-head"><span>In Review</span><span class="pw-tabular" data-col-count>1</span></div>
      <div class="pw-col-list">
        <article class="pw-card" draggable="true" tabindex="0" data-card-id="WEB-21">
          <div class="pw-card-key">WEB-21 · <span class="pw-prio-med">medium</span></div>
          <div class="pw-card-title">Link GitHub PR #42 preview</div>
          <div class="pw-card-controls">
            <button type="button" data-move="prev" aria-label="Move WEB-21 left">&larr;</button>
            <button type="button" data-move="next" aria-label="Move WEB-21 right">&rarr;</button>
          </div>
        </article>
      </div>
    </div>

    <div class="pw-preview-col" data-col="done">
      <div class="pw-col-head"><span>Done</span><span class="pw-tabular" data-col-count>0</span></div>
      <div class="pw-col-list"></div>
    </div>
  </div>

  <div class="pw-preview-fallback" id="pw-preview-fallback">
    <Image src={boardLight} alt="Patchwork Kanban board static preview (light)" class="pw-img-light" loading="lazy" />
    <Image src={boardDark} alt="Patchwork Kanban board static preview (dark)" class="pw-img-dark" loading="lazy" />
  </div>

  <dialog class="pw-cmd-dialog" id="pw-preview-dialog" aria-label="Preview command bar">
    <div class="pw-cmd-box">
      <input
        type="text"
        id="pw-preview-input"
        placeholder="Try /new Fix login, /move API-14 Done, or /docs"
        aria-label="Preview command input"
      />
      <div class="pw-cmd-hints">
        <button type="button" data-demo-cmd="/new Audit MinIO policy">/new</button>
        <button type="button" data-demo-cmd="/move API-14 Done">/move</button>
        <button type="button" data-demo-cmd="/docs">/docs</button>
      </div>
      <p class="pw-cmd-status" id="pw-preview-cmd-status" role="status"></p>
      <button type="button" class="pw-cmd-close" id="pw-preview-close">Close (Esc)</button>
    </div>
  </dialog>
</div>

<script>
  const board = document.getElementById("pw-preview-board");
  const fallback = document.getElementById("pw-preview-fallback");
  if (board && fallback) {
    board.hidden = false;
    fallback.hidden = true;
  }

  const cols = Array.from(document.querySelectorAll(".pw-preview-col"));
  const updateCounts = () => {
    for (const c of cols) {
      const count = c.querySelectorAll(".pw-card").length;
      const badge = c.querySelector("[data-col-count]");
      if (badge) badge.textContent = String(count);
    }
  };

  let draggedId = "";
  board?.addEventListener("dragstart", (e) => {
    const card = e.target instanceof Element ? e.target.closest(".pw-card") : null;
    if (card) draggedId = card.getAttribute("data-card-id") || "";
  });
  board?.addEventListener("dragover", (e) => e.preventDefault());
  board?.addEventListener("drop", (e) => {
    e.preventDefault();
    const col = e.target instanceof Element ? e.target.closest(".pw-preview-col") : null;
    const card = board.querySelector(`.pw-card[data-card-id="${draggedId}"]`);
    if (col && card) {
      col.querySelector(".pw-col-list")?.appendChild(card);
      updateCounts();
    }
  });

  board?.addEventListener("click", (e) => {
    const btn = e.target instanceof Element ? e.target.closest("button[data-move]") : null;
    if (!btn) return;
    const card = btn.closest(".pw-card");
    const col = btn.closest(".pw-preview-col");
    if (!card || !col) return;
    const idx = cols.indexOf(col);
    const nextIdx = btn.getAttribute("data-move") === "next" ? idx + 1 : idx - 1;
    if (nextIdx >= 0 && nextIdx < cols.length) {
      cols[nextIdx].querySelector(".pw-col-list")?.appendChild(card);
      updateCounts();
    }
  });

  board?.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
    const card = e.target instanceof Element ? e.target.closest(".pw-card") : null;
    const col = card?.closest(".pw-preview-col");
    if (!card || !col) return;
    e.preventDefault();
    const idx = cols.indexOf(col);
    const nextIdx = e.key === "ArrowRight" ? idx + 1 : idx - 1;
    if (nextIdx >= 0 && nextIdx < cols.length) {
      cols[nextIdx].querySelector(".pw-col-list")?.appendChild(card);
      updateCounts();
      if (card instanceof HTMLElement) card.focus();
    }
  });

  const dlg = document.getElementById("pw-preview-dialog") as HTMLDialogElement | null;
  const cmdBtn = document.getElementById("pw-preview-cmd-btn");
  const closeBtn = document.getElementById("pw-preview-close");
  const input = document.getElementById("pw-preview-input") as HTMLInputElement | null;
  const status = document.getElementById("pw-preview-cmd-status");

  const openCmd = () => {
    dlg?.showModal();
    input?.focus();
  };
  cmdBtn?.addEventListener("click", openCmd);
  closeBtn?.addEventListener("click", () => dlg?.close());
  document.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      openCmd();
    }
  });

  const runDemo = (raw: string) => {
    const cmd = raw.trim();
    if (cmd.startsWith("/new ")) {
      const title = cmd.slice(5).trim() || "New sample ticket";
      const id = `PW-${Math.floor(30 + Math.random() * 60)}`;
      const card = document.createElement("article");
      card.className = "pw-card";
      card.draggable = true;
      card.tabIndex = 0;
      card.setAttribute("data-card-id", id);
      card.innerHTML = `<div class="pw-card-key">${id} · <span>medium</span></div><div class="pw-card-title"></div><div class="pw-card-controls"><button type="button" data-move="prev">&larr;</button><button type="button" data-move="next">&rarr;</button></div>`;
      const tEl = card.querySelector(".pw-card-title");
      if (tEl) tEl.textContent = title;
      cols[0]?.querySelector(".pw-col-list")?.appendChild(card);
      updateCounts();
      if (status) status.textContent = `Created ${id} in New.`;
    } else if (cmd.startsWith("/move ")) {
      const parts = cmd.slice(6).trim().split(/\s+/);
      const key = parts[0]?.toUpperCase();
      const target = (parts.slice(1).join(" ") || "Done").toLowerCase();
      const card = board?.querySelector(`.pw-card[data-card-id="${key}"]`);
      const col = cols.find((c) => (c.querySelector(".pw-col-head span")?.textContent || "").toLowerCase().includes(target));
      if (card && col) {
        col.querySelector(".pw-col-list")?.appendChild(card);
        updateCounts();
        if (status) status.textContent = `Moved ${key} to ${col.querySelector(".pw-col-head span")?.textContent}.`;
      } else if (status) {
        status.textContent = "Specify card key and column (e.g. /move API-14 Done).";
      }
    } else if (cmd.startsWith("/docs")) {
      if (status) status.textContent = "Docs live at /documentation/ — opening overview.";
    } else if (status) {
      status.textContent = "Try /new <title>, /move API-14 Done, or /docs.";
    }
  };

  input?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      runDemo(input.value);
    }
  });
  document.querySelectorAll("[data-demo-cmd]").forEach((b) => {
    b.addEventListener("click", () => {
      const v = b.getAttribute("data-demo-cmd") || "";
      if (input) input.value = v;
      runDemo(v);
    });
  });
</script>

<style>
  .pw-preview-shell {
    border: 1px solid var(--pw-border);
    border-radius: var(--pw-radius-md);
    background: var(--pw-surface);
    padding: 1rem;
  }
  .pw-preview-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .pw-preview-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: var(--pw-radius-sm);
    background: var(--pw-accent-soft);
    color: #9e310d;
  }
  :root[data-theme="dark"] .pw-preview-badge {
    color: var(--pw-accent);
  }
  .pw-cmd-trigger {
    appearance: none;
    border: 1px solid var(--pw-border);
    background: var(--pw-bg);
    color: var(--pw-ink);
    border-radius: var(--pw-radius-sm);
    padding: 0.4rem 0.75rem;
    min-height: 44px;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .pw-preview-board {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (max-width: 820px) {
    .pw-preview-board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .pw-preview-board {
      grid-template-columns: 1fr;
    }
  }
  .pw-preview-col {
    background: var(--pw-bg);
    border: 1px solid var(--pw-border);
    border-radius: var(--pw-radius-sm);
    padding: 0.65rem;
    min-height: 150px;
  }
  .pw-col-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 0.6rem;
    color: var(--pw-ink-secondary);
  }
  .pw-col-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pw-card {
    background: var(--pw-surface);
    border: 1px solid var(--pw-border);
    border-radius: var(--pw-radius-sm);
    padding: 0.6rem;
    cursor: grab;
  }
  .pw-card-key {
    font-family: var(--pw-font-mono);
    font-size: 0.75rem;
    color: var(--pw-ink-secondary);
  }
  .pw-card-title {
    font-size: 0.875rem;
    font-weight: 600;
    margin: 0.25rem 0 0.4rem;
  }
  .pw-card-controls {
    display: flex;
    gap: 0.35rem;
  }
  .pw-card-controls button {
    border: 1px solid var(--pw-border);
    background: var(--pw-bg);
    color: var(--pw-ink);
    border-radius: var(--pw-radius-sm);
    min-width: 36px;
    min-height: 36px;
    cursor: pointer;
  }
  .pw-cmd-dialog {
    border: 1px solid var(--pw-border);
    border-radius: var(--pw-radius-md);
    background: var(--pw-surface);
    color: var(--pw-ink);
    padding: 1rem;
    width: min(460px, 92vw);
  }
  .pw-cmd-box {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pw-cmd-box input {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--pw-border);
    border-radius: var(--pw-radius-sm);
    background: var(--pw-bg);
    color: var(--pw-ink);
    font-family: var(--pw-font-mono);
    font-size: 0.875rem;
  }
  .pw-cmd-hints {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pw-cmd-hints button,
  .pw-cmd-close {
    border: 1px solid var(--pw-border);
    background: var(--pw-bg);
    color: var(--pw-ink);
    border-radius: var(--pw-radius-sm);
    padding: 0.4rem 0.7rem;
    min-height: 44px;
    cursor: pointer;
  }
  .pw-preview-fallback img {
    width: 100%;
    height: auto;
    border-radius: var(--pw-radius-sm);
  }
  :root[data-theme="light"] .pw-img-dark,
  :root[data-theme="dark"] .pw-img-light {
    display: none;
  }
</style>

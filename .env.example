# Database (PostgreSQL 16+)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/patchwork

# App Server
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=patchwork-default-dev-secret-change-in-production-32bytes
CSRF_SECRET=patchwork-default-csrf-secret-change-in-production-32bytes
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MinIO / S3-compatible Attachment Storage
S3_ENDPOINT=http://127.0.0.1:9000
# Browser-facing MinIO URL used to sign presigned upload/download URLs.
# Keep http://localhost:9000 for local dev; use https://files.<domain> behind a dedicated reverse-proxy host in production.
MINIO_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=patchwork
MAX_ATTACHMENT_BYTES=10485760

# Optional GitHub / GitLab API Tokens for higher rate limits on link fetching
GITHUB_TOKEN=
GITLAB_TOKEN=

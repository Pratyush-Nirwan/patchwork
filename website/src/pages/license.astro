---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import appMeta from "../data/generated/app-meta.json";

const rawBase = process.env.SITE_BASE || "/";
const basePrefix = rawBase === "/" ? "" : `/${rawBase.replace(/^\/+|\/+$/g, "")}`;
const repoUrl = process.env.REPO_URL || appMeta.repositoryUrl;
const href = (p: string) => `${basePrefix}${p}`;
---

<MarketingLayout
  title={`License — Patchwork ${appMeta.displayVersion}`}
  description="Patchwork is open-source engineering ticketing software licensed under GNU AGPL-3.0. Free to self-host on your own servers."
  canonicalPath="/license/"
>
  <div class="pw-container pw-page-body">
    <h1>License ({appMeta.license})</h1>
    <p class="pw-measure">
      Patchwork is open-source software licensed under the GNU Affero General Public License v3.0
      (<code>{appMeta.license}</code>). If you run a modified version as a hosted network service, you
      must make the modified source code available under {appMeta.license}.
    </p>
    <p>
      Read the full <a href={`${repoUrl}/blob/main/LICENSE`}>LICENSE</a> on GitHub or see
      <a href={href("/documentation/project/license-and-contributing/")}>License &amp; Contributing</a>.
    </p>
  </div>
</MarketingLayout>

<style>
  .pw-page-body {
    padding: 3rem 1.25rem;
    max-width: 820px;
  }
  .pw-measure {
    max-width: var(--pw-measure);
    color: var(--pw-ink-secondary);
  }
</style>

---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import appMeta from "../data/generated/app-meta.json";

const rawBase = process.env.SITE_BASE || "/";
const basePrefix = rawBase === "/" ? "" : `/${rawBase.replace(/^\/+|\/+$/g, "")}`;
const repoUrl = process.env.REPO_URL || appMeta.repositoryUrl;
const href = (p: string) => `${basePrefix}${p}`;
---

<MarketingLayout
  title={`Security — Patchwork ${appMeta.displayVersion}`}
  description="Authentication, Argon2id, CSRF, encrypted setup tokens, and private vulnerability reporting."
  canonicalPath="/security/"
>
  <div class="pw-container pw-page-body">
    <h1>Security</h1>
    <p class="pw-measure">
      Patchwork stores passwords with <code>argon2id</code>, enforces HTTP-only session cookies and
      <code>x-csrf-token</code> validation, checks RBAC permissions server-side on every route, and
      encrypts the initial Admin Setup Token with <code>AES-256-GCM</code>.
    </p>
    <h2>Reporting a vulnerability</h2>
    <p class="pw-measure">
      Do not open public issues for security vulnerabilities. Follow the private disclosure instructions
      in <a href={`${repoUrl}/blob/main/SECURITY.md`}>SECURITY.md</a> and review the
      <a href={href("/documentation/operations/security/")}>Security documentation</a>.
    </p>
  </div>
</MarketingLayout>

<style>
  .pw-page-body {
    padding: 3rem 1.25rem;
    max-width: 820px;
  }
  .pw-measure {
    max-width: var(--pw-measure);
    color: var(--pw-ink-secondary);
  }
</style>

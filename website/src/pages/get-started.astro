---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import appMeta from "../data/generated/app-meta.json";

const rawBase = process.env.SITE_BASE || "/";
const basePrefix = rawBase === "/" ? "" : `/${rawBase.replace(/^\/+|\/+$/g, "")}`;
const href = (p: string) => `${basePrefix}${p}`;
---

<MarketingLayout
  title={`Get started — Patchwork ${appMeta.displayVersion}`}
  description="Install Patchwork in three steps on Windows and Linux with only Node.js and git."
  canonicalPath="/get-started/"
>
  <div class="pw-container pw-page-body">
    <h1>Get started with Patchwork {appMeta.displayVersion}</h1>
    <p class="pw-measure">
      Prerequisites for Easy mode: <strong>Node.js {appMeta.nodeRequirement}</strong> and <strong>git</strong>.
      No Docker required.
    </p>

    <div class="pw-steps">
      <div class="pw-step">
        <h2>1. Clone and install dependencies</h2>
        <pre><code>git clone {appMeta.cloneUrl}
cd patchwork
npm ci</code></pre>
      </div>
      <div class="pw-step">
        <h2>2. Run the interactive installer</h2>
        <pre><code>npm run setup</code></pre>
        <p>Select <strong>Easy (recommended)</strong> to auto-provision PostgreSQL 18 and SHA-256 verified MinIO inside the project folder.</p>
      </div>
      <div class="pw-step">
        <h2>3. Open the Setup Wizard</h2>
        <p>Open the printed URL (default <code>http://localhost:3000/setup</code>), enter your one-time Admin Setup Token, and create your admin account and first team.</p>
      </div>
    </div>

    <p class="pw-next">
      Need external PostgreSQL and MinIO? Read <a href={href("/documentation/getting-started/advanced-installation/")}>Advanced Installation</a> or the full <a href={href("/documentation/getting-started/quick-start/")}>Quick Start docs</a>.
    </p>
  </div>
</MarketingLayout>

<style>
  .pw-page-body {
    padding: 3rem 1.25rem;
    max-width: 820px;
  }
  .pw-measure {
    color: var(--pw-ink-secondary);
  }
  .pw-steps {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 2rem 0;
  }
  .pw-step {
    background: var(--pw-surface);
    border: 1px solid var(--pw-border);
    border-radius: var(--pw-radius-md);
    padding: 1.15rem;
  }
  .pw-step h2 {
    margin: 0 0 0.65rem;
    font-size: 1.15rem;
  }
  .pw-step pre {
    margin: 0 0 0.65rem;
    padding: 0.75rem;
    background: var(--pw-rail-bg);
    color: var(--pw-rail-ink);
    border-radius: var(--pw-radius-sm);
    overflow-x: auto;
  }
</style>

---
import Default from "@astrojs/starlight/components/Footer.astro";
import appMeta from "../data/generated/app-meta.json";
---

<Default {...Astro.props} />
<div class="pw-version-footer">
  <span>Patchwork — Self-hosted engineering ticketing ({appMeta.license})</span>
  <span class="pw-version-badge" data-testid="docs-footer-version">{appMeta.displayVersion}</span>
</div>
{Boolean(Astro.site) && (
  <Fragment set:html={`<!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "52008c0fd3db4049ad5616ab9874d798"}'></script><!-- End Cloudflare Web Analytics -->`} />
)}

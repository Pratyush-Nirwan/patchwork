---
import fs from "node:fs";
import path from "node:path";
import { Image } from "astro:assets";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import MotionHeroStage from "../components/marketing/MotionHeroStage.astro";
import WhyPatchworkBento from "../components/marketing/WhyPatchworkBento.astro";
import appMeta from "../data/generated/app-meta.json";
import boardLight from "../assets/screenshots/board-light.png";
import boardDark from "../assets/screenshots/board-dark.png";
import ticketLight from "../assets/screenshots/ticket-panel-light.png";
import ticketDark from "../assets/screenshots/ticket-panel-dark.png";
import cmdLight from "../assets/screenshots/command-palette-light.png";
import cmdDark from "../assets/screenshots/command-palette-dark.png";
import sysLight from "../assets/screenshots/system-config-light.png";
import sysDark from "../assets/screenshots/system-config-dark.png";

const rawBase = process.env.SITE_BASE || "/";
const basePrefix = rawBase === "/" ? "" : `/${rawBase.replace(/^\/+|\/+$/g, "")}`;
const repoUrl = process.env.REPO_URL || appMeta.repositoryUrl;
const href = (p: string) => `${basePrefix}${p}`;

// Read roadmap categories from src/data/roadmap.yaml
const roadmapRaw = fs.readFileSync(path.resolve("src/data/roadmap.yaml"), "utf8");
const roadmapCategories = [...roadmapRaw.matchAll(/^\s*title:\s*"([^"]+)"/gm)]
  .slice(0, 5)
  .map((m) => m[1]);
---

<MarketingLayout
  title={`Patchwork (${appMeta.displayVersion}) — Self-hosted engineering ticketing`}
  description="Self-hosted ticketing for engineering orgs with teams, projects, and Kanban boards. Runs natively on Windows and Linux with Node.js, PostgreSQL, and MinIO."
  canonicalPath="/"
>
  <MotionHeroStage href={href} repoUrl={repoUrl} />

  <WhyPatchworkBento href={href} />

  <section class="pw-section pw-section-alt" data-pw-reveal>
    <div class="pw-container">
      <div class="pw-section-head">
        <h2>Inside the workspace</h2>
        <a href={href("/features/")}>All features &rarr;</a>
      </div>

      <div class="pw-tour-list">
        <article class="pw-tour-item">
          <div class="pw-tour-copy">
            <h3>Kanban &amp; Calendar views</h3>
            <p>
              Drag tickets across columns or switch to Calendar view. Updates sync live.
            </p>
          </div>
          <div class="pw-frame">
            <Image src={boardLight} alt="Patchwork Kanban board view (light)" class="pw-img-light" loading="lazy" />
            <Image src={boardDark} alt="Patchwork Kanban board view (dark)" class="pw-img-dark" loading="lazy" />
          </div>
        </article>

        <article class="pw-tour-item pw-tour-reverse">
          <div class="pw-tour-copy">
            <h3>Tickets &amp; file uploads</h3>
            <p>
              Markdown comments, MinIO file uploads, and linked GitHub or GitLab PRs.
            </p>
          </div>
          <div class="pw-frame">
            <Image src={ticketLight} alt="Patchwork ticket detail side panel (light)" class="pw-img-light" loading="lazy" />
            <Image src={ticketDark} alt="Patchwork ticket detail side panel (dark)" class="pw-img-dark" loading="lazy" />
          </div>
        </article>

        <article class="pw-tour-item">
          <div class="pw-tour-copy">
            <h3>Command bar &amp; search</h3>
            <p>
              Press <code>Ctrl+K</code> to search everything or run slash commands like <code>/move</code>.
            </p>
          </div>
          <div class="pw-frame">
            <Image src={cmdLight} alt="Patchwork Spotlight command bar with slash commands (light)" class="pw-img-light" loading="lazy" />
            <Image src={cmdDark} alt="Patchwork Spotlight command bar with slash commands (dark)" class="pw-img-dark" loading="lazy" />
          </div>
        </article>

        <article class="pw-tour-item pw-tour-reverse">
          <div class="pw-tour-copy">
            <h3>Admin dashboard</h3>
            <p>
              Manage users, roles, storage limits, and system health in one place.
            </p>
          </div>
          <div class="pw-frame">
            <Image src={sysLight} alt="Patchwork System Configuration dashboard (light)" class="pw-img-light" loading="lazy" />
            <Image src={sysDark} alt="Patchwork System Configuration dashboard (dark)" class="pw-img-dark" loading="lazy" />
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="pw-section pw-section-alt" data-pw-reveal>
    <div class="pw-container pw-split">
      <div>
        <h2>Ready in minutes</h2>
        <p>
          Run <code>npm run setup</code> to install PostgreSQL, MinIO, and database migrations automatically.
        </p>
        <p>
          Use <code>npm run setup -- --advanced</code> to connect your own PostgreSQL and MinIO.
        </p>
        <a href={href("/get-started/")}>Install guide &rarr;</a>
      </div>

      <div>
        <h2>Built for admins</h2>
        <ul class="pw-plain-list">
          <li><strong>Private:</strong> No public signup.</li>
          <li><strong>RBAC:</strong> Admin, Team Lead, Member, and Viewer roles.</li>
          <li><strong>Encrypted setup:</strong> One-time <code>AES-256-GCM</code> setup token.</li>
          <li><strong>CLI controls:</strong> <code>start</code>, <code>stop</code>, <code>status</code>, and <code>repair</code>.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="pw-section pw-mobile-hide" data-pw-reveal>
    <div class="pw-container">
      <h2>Under the hood</h2>
      <p class="pw-measure">
        Next.js, Drizzle ORM, PostgreSQL, and MinIO.
      </p>
      <div class="pw-arch-box">
        <svg viewBox="0 0 820 190" width="820" height="190" role="img" aria-label="Patchwork native architecture diagram: Browser connects to Next.js App Router, which connects to PostgreSQL and MinIO">
          <rect x="16" y="45" width="175" height="90" rx="6" class="arch-node" />
          <text x="103" y="84" text-anchor="middle" class="arch-title">Browser</text>
          <text x="103" y="106" text-anchor="middle" class="arch-sub">Kanban + SSE + Ctrl+K</text>

          <rect x="295" y="45" width="210" height="90" rx="6" class="arch-node arch-node-accent" />
          <text x="400" y="84" text-anchor="middle" class="arch-title">Next.js App Router</text>
          <text x="400" y="106" text-anchor="middle" class="arch-sub">API + RBAC + Drizzle ORM</text>

          <rect x="605" y="14" width="200" height="70" rx="6" class="arch-node" />
          <text x="705" y="45" text-anchor="middle" class="arch-title">PostgreSQL 16+</text>
          <text x="705" y="65" text-anchor="middle" class="arch-sub">LISTEN/NOTIFY + FTS</text>

          <rect x="605" y="106" width="200" height="70" rx="6" class="arch-node" />
          <text x="705" y="137" text-anchor="middle" class="arch-title">MinIO Storage</text>
          <text x="705" y="157" text-anchor="middle" class="arch-sub">Presigned Uploads</text>

          <line x1="191" y1="90" x2="295" y2="90" class="arch-line arch-line-flow" />
          <line x1="505" y1="75" x2="605" y2="49" class="arch-line arch-line-flow" />
          <line x1="505" y1="105" x2="605" y2="141" class="arch-line arch-line-flow" />
          <circle r="3.5" class="arch-packet">
            <animateMotion dur="2.2s" repeatCount="indefinite" path="M191,90 L295,90" />
          </circle>
          <circle r="3.5" class="arch-packet">
            <animateMotion dur="2.4s" begin="0.4s" repeatCount="indefinite" path="M505,75 L605,49" />
          </circle>
          <circle r="3.5" class="arch-packet">
            <animateMotion dur="2.6s" begin="0.8s" repeatCount="indefinite" path="M505,105 L605,141" />
          </circle>
          <circle r="3" class="arch-packet arch-packet-return">
            <animateMotion dur="2.5s" begin="1.1s" repeatCount="indefinite" path="M605,49 L505,75 L295,90 L191,90" />
          </circle>
        </svg>
      </div>
    </div>
  </section>

  <!-- ROADMAP_TEASER_START -->
  <section class="pw-section pw-section-alt pw-mobile-hide" data-pw-reveal>
    <div class="pw-container">
      <h2>Planned for v1.0.0</h2>
      <p class="pw-measure">
        This roadmap describes planned work. Scope and timing may change. Planned areas include:
        <strong>{roadmapCategories.join(" · ")}</strong>.
      </p>
      <a href={href("/documentation/project/roadmap/")}>View the full v1.0.0 Roadmap &rarr;</a>
    </div>
  </section>
  <!-- ROADMAP_TEASER_END -->

  <section class="pw-section" data-pw-reveal>
    <div class="pw-container pw-split">
      <div>
        <h2>Open source (AGPL-3.0)</h2>
        <p>
          Free to self-host. Share changes if you run it as a public service.
        </p>
        <div class="pw-inline-links">
          <a href={repoUrl}>GitHub</a>
          <a href={href("/license/")}>License</a>
          <a href={href("/security/")}>Security</a>
        </div>
      </div>

      <div>
        <h2>FAQ</h2>
        <div class="pw-faq">
          <details>
            <summary>Does Patchwork need Docker?</summary>
            <p>No. It runs natively on Windows and Linux with Node.js, PostgreSQL, and MinIO.</p>
          </details>
          <details>
            <summary>Is it ready for production ({appMeta.displayVersion})?</summary>
            <p>It is pre-1.0 beta software. Back up your database, <code>.env</code>, and MinIO before upgrading.</p>
          </details>
          <details>
            <summary>Which OSes are supported?</summary>
            <p>Windows 10/11 (x64) and Linux (Ubuntu 22.04/24.04, Debian 12 on x64 and arm64).</p>
          </details>
          <details>
            <summary>Where is my data stored?</summary>
            <p>Tickets live in PostgreSQL and file attachments live in MinIO on your server.</p>
          </details>
          <details>
            <summary>Is there a hosted SaaS version?</summary>
            <p>No. Patchwork is self-hosted only.</p>
          </details>
          <details>
            <summary>How do I report a bug?</summary>
            <p>Open an issue on GitHub, or see <a href={href("/security/")}>Security</a> for vulnerabilities.</p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <section class="pw-section pw-closing">
    <div class="pw-container">
      <h2>Ready to start?</h2>
      <p>Clone the repo and run <code>npm run setup</code>.</p>
      <div class="pw-cta-row">
        <a class="pw-btn pw-btn-primary" href={href("/documentation/getting-started/quick-start/")}>Quick start guide</a>
        <a class="pw-btn pw-btn-secondary" href={href("/documentation/")}>Browse documentation</a>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .pw-patch-bg {
    background-image:
      linear-gradient(to right, var(--pw-border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--pw-border) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: top center;
  }
  .pw-hero {
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--pw-border);
  }
  .pw-hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 2rem;
    align-items: start;
  }
  .pw-hero-grid > * {
    min-width: 0;
  }
  @media (max-width: 960px) {
    .pw-hero-grid {
      grid-template-columns: 1fr;
    }
  }
  .pw-beta-pill {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: var(--pw-radius-sm);
    background: var(--pw-surface);
    border: 1px solid var(--pw-border);
    margin-bottom: 1rem;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 3.1rem);
    margin: 0 0 1rem;
  }
  .pw-lead {
    font-size: 1.125rem;
    color: var(--pw-ink-secondary);
    max-width: 54ch;
    margin: 0 0 1.5rem;
  }
  .pw-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .pw-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.55rem 1.1rem;
    border-radius: var(--pw-radius-sm);
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
  }
  .pw-btn-primary {
    background: var(--pw-accent);
    color: #ffffff;
  }
  :root[data-theme="dark"] .pw-btn-primary {
    color: #0d1014;
  }
  .pw-btn-secondary {
    background: var(--pw-surface);
    color: var(--pw-ink);
    border-color: var(--pw-border);
  }
  .pw-btn-ghost {
    color: var(--pw-ink);
  }
  .pw-terminal {
    background: var(--pw-rail-bg);
    color: var(--pw-rail-ink);
    border-radius: var(--pw-radius-md);
    border: 1px solid #28313e;
    padding: 1rem;
    max-width: 100%;
    min-width: 0;
  }
  .pw-terminal-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: #9aa6b5;
    margin-bottom: 0.75rem;
  }
  .pw-os-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  .pw-os-grid > * {
    min-width: 0;
  }
  .pw-os-label {
    font-size: 0.75rem;
    color: #9aa6b5;
    margin-bottom: 0.25rem;
  }
  .pw-terminal pre {
    margin: 0;
    padding: 0.65rem;
    background: #090c10;
    border-radius: var(--pw-radius-sm);
    font-size: 0.8rem;
    overflow-x: auto;
  }
  .pw-hero-shot {
    margin-top: 2.5rem;
  }
  .pw-frame {
    border: 1px solid var(--pw-border);
    border-radius: var(--pw-radius-md);
    overflow: hidden;
    background: var(--pw-surface);
  }
  .pw-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  :root[data-theme="light"] .pw-img-dark,
  :root[data-theme="dark"] .pw-img-light {
    display: none;
  }
  :global(.pw-section) {
    padding: clamp(5rem, 8.5vw, 7.5rem) 0;
  }
  :global(.pw-section-alt) {
    background: var(--pw-surface);
    border-top: 1px solid var(--pw-border);
    border-bottom: 1px solid var(--pw-border);
  }
  :global(.pw-section-head) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .pw-tour-list {
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }
  .pw-tour-item {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 3rem;
    align-items: center;
  }
  .pw-tour-reverse {
    grid-template-columns: 1.15fr 0.85fr;
  }
  .pw-tour-reverse .pw-tour-copy {
    order: 2;
  }
  @media (max-width: 860px) {
    .pw-tour-item,
    .pw-tour-reverse {
      grid-template-columns: 1fr;
    }
    .pw-tour-reverse .pw-tour-copy {
      order: 0;
    }
  }
  .pw-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }
  @media (max-width: 820px) {
    .pw-split {
      grid-template-columns: 1fr;
    }
  }
  .pw-plain-list {
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .pw-measure {
    max-width: var(--pw-measure);
  }
  .pw-arch-box {
    margin-top: 2rem;
    padding: 1rem 0;
    overflow-x: auto;
  }
  .pw-arch-box svg {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .arch-node {
    fill: var(--pw-bg);
    stroke: var(--pw-border);
    stroke-width: 1.5;
  }
  .arch-node-accent {
    stroke: var(--pw-accent);
  }
  .arch-title {
    fill: var(--pw-ink);
    font-family: var(--pw-font-display);
    font-weight: 600;
    font-size: 15px;
  }
  .arch-sub {
    fill: var(--pw-ink-secondary);
    font-family: var(--pw-font-mono);
    font-size: 12px;
  }
  .arch-line {
    stroke: var(--pw-ink-secondary);
    stroke-width: 1.75;
  }
  .arch-line-flow {
    stroke: var(--pw-accent);
    stroke-dasharray: 6 6;
    animation: pw-dash-flow 1.8s linear infinite;
  }
  .arch-packet {
    fill: var(--pw-accent);
  }
  @keyframes pw-dash-flow {
    from { stroke-dashoffset: 24; }
    to { stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .arch-line-flow {
      animation: none;
      stroke-dasharray: none;
    }
    .arch-packet {
      display: none;
    }
  }
  .pw-inline-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .pw-faq {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .pw-faq details {
    border: 1px solid var(--pw-border);
    border-radius: var(--pw-radius-sm);
    background: var(--pw-surface);
    padding: 0.65rem 0.9rem;
  }
  .pw-faq summary {
    cursor: pointer;
    font-weight: 600;
    min-height: 36px;
    display: flex;
    align-items: center;
  }
  .pw-faq p {
    margin: 0.5rem 0 0;
    color: var(--pw-ink-secondary);
  }
  .pw-faq details[open] p {
    animation: pw-faq-unfold 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes pw-faq-unfold {
    from { opacity: 0; transform: translate3d(0, -4px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }
  .pw-closing {
    border-top: 1px solid var(--pw-border);
  }
  @media (max-width: 720px) {
    .pw-mobile-hide {
      display: none;
    }
    :global(.pw-section) {
      padding: 2rem 0;
    }
    :global(.pw-section-head) {
      margin-bottom: 1.25rem;
    }
    .pw-tour-list {
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 1rem;
      padding-bottom: 0.5rem;
      -webkit-overflow-scrolling: touch;
    }
    .pw-tour-item {
      flex: 0 0 86%;
      scroll-snap-align: start;
      background: var(--pw-surface);
      border: 1px solid var(--pw-border);
      border-radius: var(--pw-radius-md);
      padding: 1rem;
      gap: 0.9rem;
      align-content: start;
    }
    .pw-tour-item .pw-frame {
      transform: none !important;
    }
    .pw-arch-box {
      margin-top: 1rem;
      padding: 0.5rem 0;
    }
    .pw-faq summary {
      min-height: 44px;
      display: flex;
      align-items: center;
    }
  }
  @media (max-width: 520px) {
    .pw-closing .pw-cta-row {
      flex-direction: column;
    }
    .pw-closing .pw-btn {
      width: 100%;
      justify-content: center;
    }
  }
  :global([data-pw-reveal]) {
    opacity: 0;
    transform: translate3d(0, 22px, 0);
    transition: opacity 560ms cubic-bezier(0.22, 1, 0.36, 1), transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global([data-pw-reveal].is-visible) {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
  .pw-tour-item .pw-frame {
    transform: scale(0.96);
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pw-tour-item.is-visible .pw-frame,
  [data-pw-reveal].is-visible .pw-tour-item .pw-frame {
    transform: scale(1);
  }
  .pw-tour-item .pw-frame:hover img {
    transform: scale(1.02);
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    :global([data-pw-reveal]),
    .pw-tour-item .pw-frame,
    .pw-tour-item .pw-frame:hover img {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const revealEls = [...document.querySelectorAll("[data-pw-reveal]")];
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reduced || !("IntersectionObserver" in window)) {
    revealEls.forEach((el) => el.classList.add("is-visible"));
  } else {
    const obs = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
    );
    revealEls.forEach((el) => obs.observe(el));

    // Smooth parallax glide on workspace tour frames
    const tourFrames = [...document.querySelectorAll(".pw-tour-item .pw-frame")] as HTMLElement[];
    if (tourFrames.length > 0) {
      let raf = 0;
      const onTourScroll = () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          const vh = window.innerHeight || 800;
          for (const frame of tourFrames) {
            const r = frame.getBoundingClientRect();
            const centerOffset = (r.top + r.height / 2 - vh / 2) / vh;
            const y = Math.max(-14, Math.min(14, centerOffset * 18));
            frame.style.transform = `translate3d(0, ${y.toFixed(1)}px, 0) scale(1)`;
          }
          raf = 0;
        });
      };
      window.addEventListener("scroll", onTourScroll, { passive: true });
    }
  }
</script>
